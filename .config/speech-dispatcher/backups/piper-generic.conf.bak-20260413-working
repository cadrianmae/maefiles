GenericExecuteSynth "\
    SAMPLE_RATE=$(jq -r '.audio.sample_rate' /home/cadrianmae/.local/share/piper-voices/$VOICE.json 2>/dev/null || echo 22050); \
    printf %s \"$DATA\" \
    | /home/cadrianmae/.local/bin/piper \
        --length-scale 0.5 \
        --sentence-silence 0.1 \
        --model /home/cadrianmae/.local/share/piper-voices/$VOICE \
        --cuda \
        --output-raw \
        -f - \
    | sox \
        -v $VOLUME \
        -r $SAMPLE_RATE \
        -c 1 \
        -b 16 \
        -e signed-integer \
        -t raw - \
        -t wav - \
        tempo $RATE \
        pitch $PITCH \
        norm \
    | mpv --no-terminal --keep-open=no -\
"
# GenericExecuteSynth "printf %s \"$DATA\" | /home/cadrianmae/.local/bin/piper --model /home/cadrianmae/.local/share/piper-voices/$VOICE -f - | mpv --no-terminal --keep-open=no -"

AddVoice "en-GB" "FEMALE1" "en_GB-aru-medium.onnx"
AddVoice "en-GB" "FEMALE2" "en_GB-southern_english_female-low.onnx"

DefaultVoice "en_GB-southern_english_female-low.onnx"

# Speech Dispatcher parameter multipliers
GenericRateAdd 1
GenericRateMultiply 1
GenericPitchAdd 1
GenericPitchMultiply 750
GenericVolumeAdd 1
GenericVolumeMultiply 2

# Prevent long pauses between sentences
GenericDelimiters "|"
GenericMaxChunkLength 99999
