# Position and layout
anchor=top-right
default-timeout=5000
max-visible=3
sort=-time
layer=overlay
margin=10

# Appearance
font=Cantarell 10
width=350
height=100
border-size=2
border-radius=8
padding=10
icons=1
max-icon-size=48

# Catppuccin Macchiato Flamingo colors
background-color=#24273a
text-color=#cad3f5
border-color=#f0c6c6
progress-color=over #363a4f

[urgency=low]
border-color=#8087a2

[urgency=high]
border-color=#f5a97f
default-timeout=0

[urgency=critical]
border-color=#ed8796
default-timeout=0
