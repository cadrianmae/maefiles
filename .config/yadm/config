# yadm config defaults
# Machine-local overrides go in ~/.config/yadm/local.conf (not tracked)

[yadm]
	# Use GPG (not OpenSSL) for `yadm encrypt`
	cipher = gpg
	# Use asymmetric encryption — archive can be pushed publicly and only
	# machines with the recipient key can decrypt. Matches the git-crypt model.
	gpg-recipient = C8ABE62412652B9E
