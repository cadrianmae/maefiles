# Patterns for files to include in `yadm encrypt` → gpg archive
# One pattern per line. Negation with ! prefix.
#
# The resulting archive lives at ~/.local/share/yadm/archive and IS tracked.
# Working-copy files remain plaintext locally (listed below); the archive is
# the encrypted commitable artifact.

# SSH keys
.ssh/id_ed25519
.ssh/id_ed25519.pub
.ssh/id_rsa
.ssh/id_rsa.pub

# Known hosts (not strictly secret but host-enumeration risk if public)
.ssh/known_hosts

# GPG revocation certificates (if stored)
.gnupg/openpgp-revocs.d/*

# Example: exclude any "*.example" placeholder files
!*.example
