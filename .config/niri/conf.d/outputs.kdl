// Monitor configuration. Nothing here is active -- the block below is a
// disabled template (/- comments out the node that follows).
// Run `niri msg outputs` to list connectors and their modes.
// https://niri-wm.github.io/niri/Configuration:-Outputs
/-output "eDP-1" {
    // off

    // "<width>x<height>" or "<width>x<height>@<refresh>"; omitted or invalid
    // picks automatically, omitted refresh picks the highest for that resolution
    mode "1920x1080@120.030"

    // integer or fractional, e.g. 1.5 for 150%
    scale 2

    // normal | 90 | 180 | 270 | flipped | flipped-90 | flipped-180 | flipped-270
    transform "normal"

    // Position in the global coordinate space, in LOGICAL (scaled) pixels --
    // a 3840x2160 output at scale 2 is 1920 wide, so its right-hand neighbour
    // sits at x=1920. Drives directional monitor actions and cursor movement,
    // which only crosses directly adjacent outputs. Unset or overlapping
    // positions are placed automatically.
    position x=1280 y=0
}
