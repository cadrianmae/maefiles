// Input devices.
// https://niri-wm.github.io/niri/Configuration:-Input
input {
    keyboard {
        xkb {
            layout "ie, us"
            variant ", altgr-weur"
            model "pc105"
            options "caps:escape_shifted_capslock, eurosign:4"
        }

        // omitting this disables numlock at startup
        numlock
    }

    // libinput. Omitting a setting disables it or leaves its default; the
    // commented lines below are examples, not defaults.
    touchpad {
        // off
        tap
        // dwt
        // dwtp
        // drag false
        // drag-lock
        natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "two-finger"
        // disabled-on-external-mouse
    }

    mouse {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "no-scroll"
    }

    // Wacom Intuos Draw (CTL-490). Without map-to-output the tablet spans the
    // full logical output space (both screens), so the pen only reaches half
    // of each. Swap to "HDMI-A-1" to draw on the AOC.
    tablet {
        map-to-output "eDP-1"
        // left-handed
    }

    trackpoint {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "on-button-down"
        // scroll-button 273
        // scroll-button-lock
        // middle-emulation
    }

    // warp-mouse-to-focus

    // max-scroll-amount="0%" limits this to windows already fully on screen
    // focus-follows-mouse max-scroll-amount="0%"
}
