binds {
    // <modifier>+<XKB key name>; `wev` finds key names. Mod is Super on a TTY,
    // Alt when niri runs nested in a winit window. Most actions here can also be
    // invoked with `niri msg action`.
    // https://niri-wm.github.io/niri/Configuration:-Key-Bindings

    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+T hotkey-overlay-title="Open a Terminal: wezterm" { spawn "wezterm"; }
    Mod+E hotkey-overlay-title="Open a File Manager: Nautilus" { spawn "nautilus"; }

    Super+Alt+L hotkey-overlay-title="Lock the Screen: Noctalia" { spawn "noctalia" "msg" "session" "lock"; }
    Mod+X hotkey-overlay-title="Session: Noctalia" { spawn "noctalia" "msg" "panel-toggle" "session"; }

    Mod+Space hotkey-overlay-title="App Launcher: Noctalia" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+S     hotkey-overlay-title="Control Center: Noctalia" { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+Shift+S hotkey-overlay-title="Noctalia Settings" { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+Ctrl+Period hotkey-overlay-title="Emoji Picker: Noctalia" { spawn "noctalia" "msg" "panel-toggle" "launcher" "/emo "; }

    // spawn-sh takes the whole command as ONE argument, passed verbatim to `sh -c`.
    Super+Alt+S allow-when-locked=true hotkey-overlay-title=null { spawn-sh "pkill orca || exec orca"; }

    // Volume via Noctalia, NOT wpctl. These were niri's stock wpctl examples,
    // which change the volume perfectly well but leave Noctalia unaware -- so no
    // OSD ever appeared. Brightness below already went through Noctalia, which is
    // why that one showed an OSD and volume did not.
    // allow-when-locked=true keeps them working on the lock screen.
    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute        allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "noctalia" "msg" "mic-mute"; }

    // Media keys via Noctalia, which drives MPRIS and draws the OSD.
    // Replaces playerctl, which isn't installed.
    XF86AudioPlay        allow-when-locked=true { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioStop        allow-when-locked=true { spawn "noctalia" "msg" "media" "stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn "noctalia" "msg" "media" "previous"; }
    XF86AudioNext        allow-when-locked=true { spawn "noctalia" "msg" "media" "next"; }

    XF86MonBrightnessUp   allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }

    // also reachable via the top-left hot corner or a four-finger swipe up
    Mod+O repeat=false { toggle-overview; }

    Mod+Q repeat=false { close-window; }

    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }

    // -or-workspace- variants carry on into the next workspace at a column's end
    // Mod+J     { focus-window-or-workspace-down; }
    // Mod+K     { focus-window-or-workspace-up; }
    // Mod+Ctrl+J     { move-window-down-or-to-workspace-down; }
    // Mod+Ctrl+K     { move-window-up-or-to-workspace-up; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    // move-window-to-monitor-* moves one window instead of the column;
    // move-workspace-to-monitor-* moves the whole workspace

    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    // move-window-to-workspace-* moves one window instead of the column

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }
    Mod+Shift+Y { move-workspace-to-monitor-left; }
    Mod+Shift+O { move-workspace-to-monitor-right; }

    // Wheel binds follow the natural-scroll setting for direction. cooldown-ms
    // rate-limits any bind, but only matters on the wheel.
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    // Usually scrolling up and down with Shift in applications results in
    // horizontal scrolling; these binds replicate that.
    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // Continuous touchpad scrolling is split into discrete ticks. These examples
    // read inverted because touchpad natural-scroll is on.
    // Mod+TouchpadScrollDown { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.02+"; }
    // Mod+TouchpadScrollUp   { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.02-"; }

    // Workspaces are dynamic, so an index past the current count lands on the
    // bottommost empty one -- with 2 workspaces + 1 empty, 3 through 9 are all
    // the 3rd.
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // move-window-to-workspace moves one window instead of the column
    // Mod+Ctrl+1 { move-window-to-workspace 1; }

    // Mod+Tab { focus-workspace-previous; }

    // consume if the window is alone, expel if it is already in a column
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    // cycles preset-column-widths from layout.kdl
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }

    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }

    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    // maximize-column keeps gaps and borders; this drops them and fills the
    // screen, like double-clicking a titlebar elsewhere
    Mod+M { maximize-window-to-edges; }

    // fills whatever other fully visible columns are not using
    Mod+Ctrl+F { expand-column-to-available-width; }

    Mod+C { center-column; }

    Mod+Ctrl+C { center-visible-columns; }

    // takes "1000" | "-5" | "+5" | "25%" | "-10%". Pixels are logical, so on a
    // scale 2.0 output "100" occupies 200 physical pixels.
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    // only applies while the window shares a column
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    // vertical tabs instead of stacking the column
    Mod+W { toggle-column-tabbed-display; }

    // Do NOT bind these to a key that xkb options also switch on -- both fire
    // and the layout switches twice.
    // Mod+Space       { switch-layout "next"; }
    // Mod+Shift+Space { switch-layout "prev"; }

    Print hotkey-overlay-title="Screenshot Monitor to Clipboard" { screenshot-screen write-to-disk=false show-pointer=false; }

    // Noctalia rather than niri's own action: it pipes the capture to satty
    // itself (see pipe_command under [shell.screenshot]), where niri's action is
    // asynchronous and signals no completion -- its PNG lands roughly 400ms after
    // the command returns, so anything piped from it reads an empty file.
    Ctrl+Print hotkey-overlay-title="Screenshot Monitor, then Crop and Annotate" { spawn "noctalia" "msg" "screenshot-fullscreen"; }

    Mod+Print hotkey-overlay-title="Screenshot a Window" { screenshot-window; }

    Alt+Print hotkey-overlay-title="Toggle Screen Recording: screenrec" { spawn "screenrec"; }

    // Remote-desktop clients and KVM switches can ask niri to stop processing
    // these binds and forward keys instead. allow-inhibiting=false exempts a
    // bind from that, so this one stays an escape hatch from a buggy app.
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // shows a confirmation dialog
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }

    // any input turns them back on
    Mod+Shift+P { power-off-monitors; }

    Mod+Alt+K { switch-layout "next"; }
    Mod+Alt+Shift+K { switch-layout "prev"; }

    // tier:strong -- toggles the controller preset on/off. Stops the grab so
    // Steam/Minecraft see the real pad (correct name + GUID for SDL).
    Mod+F1 { spawn "ir-toggle"; }

    // tier:weak -- input-remapper layer sentinels. No user-facing function;
    // they exist only so the controller's layer macro can trigger a notification.
    // YIELD: if any bind wants F2/F3, move these to the next free F-key and
    // update BOTH places -- here, and the Select (314) macro in
    // ~/.config/input-remapper-2/presets/Xbox Wireless Controller/Navigation.json
    // Layer index maps to F<index+2>. F19 is reserved (PTT).
    Mod+F2 { spawn "ir-layer-notify" "Base"; }
    Mod+F3 { spawn "ir-layer-notify" "niri navigation"; }

}
