// Session environment.
// https://niri-wm.github.io/niri/Configuration:-Miscellaneous
environment {
    // Run Firefox/Zen as native Wayland instead of X11/Xwayland.
    // Fixes drag-and-drop from Wayland apps (Nautilus) into the browser,
    // plus better fractional scaling. Restart the browser after enabling.
    MOZ_ENABLE_WAYLAND "1"

    // same for Electron apps (Vesktop, VS Code)
    // ELECTRON_OZONE_PLATFORM_HINT "auto"

    // Load qt6ct so Qt apps pick up the Noctalia palette.
    //
    // Noctalia's qt template regenerates qt5ct/qt6ct/colors/noctalia.conf on
    // every theme change, and qt6ct.conf already points at it
    // (custom_palette=true, style=Fusion) -- but without this variable Qt never
    // loads qt6ct at all, so the whole generated palette was dead weight.
    // XDG_CURRENT_DESKTOP=niri also stops Qt auto-selecting a KDE/GNOME theme,
    // so there is no fallback: unset here means unthemed.
    QT_QPA_PLATFORMTHEME "qt6ct"
}

// Cursor. niri exports XCURSOR_THEME and XCURSOR_SIZE to every client from
// this block, and with no block it exports "default" -- which overrode the
// Posy_Cursor set in gsettings and gtk-3.0/settings.ini, so the pointer stayed
// the stock Adwaita one everywhere despite the theme being installed.
//
// The theme lives in ~/.icons/Posy_Cursor (user-local, not packaged).
// Size 32 matches gtk-cursor-theme-size in gtk-3.0/settings.ini.
cursor {
    xcursor-theme "Posy_Cursor"
    xcursor-size 32
}

hotkey-overlay {
    // skip-at-startup
}

// Asks clients to drop client-side decorations, though an explicit CSD request
// is still honoured. Also marks windows tiled (removing some CSD rounded
// corners) and fixes border drawing behind semitransparent windows. Restart
// apps after changing.
// prefer-no-csd

// strftime(3) formatted, ~ expands to home
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
// null disables saving screenshots to disk
// screenshot-path null

// https://niri-wm.github.io/niri/Configuration:-Animations
animations {
    // off

    // below 1 speeds them up instead
    // slowdown 3.0
}

// Chromium/Electron (Vesktop, OBS) cannot import Intel Y_TILED_CCS dmabufs
// from the screencast stream -- every frame fails import and Go Live goes
// black. Force the INVALID (implicit) modifier so the consumer gets buffers
// it can actually map.
debug {
    force-pipewire-invalid-modifier
}
