// How windows are positioned and sized.
// https://niri-wm.github.io/niri/Configuration:-Layout
layout {
    // logical pixels
    gaps 16

    // "never" | "always" | "on-overflow" (centre only when it would not fit)
    center-focused-column "never"

    // Mod+R cycles these. proportion = fraction of output width, gaps accounted for.
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        // fixed 1920
    }

    // Mod+Ctrl+Shift+R cycles these.
    // preset-window-heights { }

    default-column-width { proportion 0.5; }
    // empty brackets lets each window pick its own initial width
    // default-column-width {}

    // Focus ring and border draw as a solid rectangle BEHIND windows, so they
    // show through semitransparent ones -- CSD windows can be any shape. Set
    // prefer-no-csd (misc.kdl) or the draw-border-with-background window rule
    // to draw around the window instead.

    focus-ring {
        on
        width 2
        // "red" | "#rgb" "#rgba" "#rrggbb" "#rrggbbaa" | rgb() rgba() hsl()
        active-color "#7fc8ff"
        // only ever visible on other monitors
        inactive-color "#505050"
        // gradients take precedence over solid colors; angle as in CSS
        // linear-gradient, default 180. relative-to="workspace-view" spans the
        // whole workspace rather than the window.
        // active-gradient from="#80c8ff" to="#c7ff7f" angle=45
        // inactive-gradient from="#505050" to="#808080" angle=45 relative-to="workspace-view"
    }

    // Same settings as focus-ring, but always visible. Disable one or the other.
    border {
        off
        width 2
        active-color "#ffc87f"
        inactive-color "#505050"
        urgent-color "#9b0000"
        // in="oklch longer hue" interpolates through the colour wheel
        // active-gradient from="#e5989b" to="#ffb4a2" angle=45 relative-to="workspace-view" in="oklch longer hue"
        // inactive-gradient from="#505050" to="#808080" angle=45 relative-to="workspace-view"
    }

    shadow {
        on
        // niri assumes square corners, so shadows artifact inside CSD rounded
        // ones. draw-behind-window hides that; prefer-no-csd or
        // geometry-corner-radius fixes it properly.
        // draw-behind-window true
        softness 30
        spread 5
        offset x=0 y=5
        color "#0008"
    }

    // Outer gaps, in logical pixels. Left/right keep the next window partly
    // visible; top/bottom add to layer-shell panels and regular gaps.
    struts {
        left 8
        right 8
        // top 64
        // bottom 64
    }
}
