// niri config — split into conf.d/ for maintainability.
// This file only wires the pieces together via `include`.
//
// Edit the individual files in conf.d/. Includes are POSITIONAL:
// a later include overrides options set by an earlier one — that is why the
// noctalia theme include sits AFTER layout (it recolours the layout).
//
// KDL format:  https://kdl.dev
// niri config: https://niri-wm.github.io/niri/Configuration:-Introduction

include "conf.d/input.kdl"       // keyboard (layouts), touchpad, mouse, trackpoint
include "conf.d/outputs.kdl"     // monitor configuration (currently all examples)
include "conf.d/layout.kdl"      // gaps, focus-ring, border, shadow, struts
include "conf.d/startup.kdl"     // spawn-at-startup (noctalia, ...)
include "conf.d/misc.kdl"        // hotkey-overlay, screenshot-path, animations
include "conf.d/rules.kdl"       // window-rules (wezterm, firefox PiP, examples)
include "conf.d/binds.kdl"       // all keybinds

include "noctalia.kdl"         // Noctalia template — base theme colours (auto-generated, tracks scheme)
// include "lumae-dusk.kdl"       // Aero overrides: gradient glass-edge sheen + shadow — MUST be last
