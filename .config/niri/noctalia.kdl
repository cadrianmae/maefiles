layout {

    focus-ring {
        active-color   "#f5c2e7"
        inactive-color "#1e1e2e"
        urgent-color   "#f38ba8"
    }

    border {
        active-color   "#f5c2e7"
        inactive-color "#1e1e2e"
        urgent-color   "#f38ba8"
    }


    tab-indicator {
        active-color   "#f5c2e7"
        inactive-color "#e123ad"
        urgent-color   "#f38ba8"
    }

    insert-hint {
        color "#f5c2e780"
    }
}

recent-windows {
    highlight {
        active-color "#f5c2e7"
        urgent-color "#f38ba8"
    }
}
