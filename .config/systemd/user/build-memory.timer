[Unit]
Description=Daily build of project memory from Claude transcripts
Documentation=man:build-memory(1)

[Timer]
# Run daily at 11 PM
OnCalendar=daily
OnCalendar=*-*-* 23:00:00

# If system was off, run 10 minutes after boot
Persistent=true

# Randomize start time by up to 15 minutes to avoid system load spikes
RandomizedDelaySec=15min

[Install]
WantedBy=timers.target
