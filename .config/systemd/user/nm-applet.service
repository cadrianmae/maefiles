[Unit]
Description=NetworkManager secret agent and tray icon for niri
Documentation=https://bbs.archlinux.org/viewtopic.php?id=246698

# nm-applet is not primarily a tray icon here -- it is the NetworkManager
# secret agent. The wifi connections use psk-flags=1, so the PSK lives in
# gnome-keyring rather than the .nmconnection file, and NM will not connect
# until an agent offers to hand it over. GNOME Shell plays that role under
# GNOME; niri ships no equivalent, which is why wifi stopped persisting after
# the move from Plasma. If this process dies, wifi silently stops working.
#
# Bound to niri specifically, NOT graphical-session.target, so it never starts
# under Plasma -- where plasma-nm is already the agent and two agents would
# contend.
BindsTo=niri.service
After=niri.service

# The keyring must be unlocked before the agent can read anything out of it.
Wants=gnome-keyring-daemon.service
After=gnome-keyring-daemon.service

StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=exec
ExecStart=/usr/bin/nm-applet --indicator

Restart=on-failure
RestartSec=2

Slice=session.slice

[Install]
WantedBy=niri.service
