[Unit]
Description=Check pass entries against manifest TTL (maefiles)
After=graphical-session.target

[Service]
Type=oneshot
# --notify-only: writes ~/.cache/yadm-secrets-stale + desktop notification.
# Does NOT prompt for bw unlock. User runs yadm-refresh-secrets interactively
# when they see the notification/shell nudge.
ExecStart=%h/bin/yadm-refresh-secrets --notify-only

# Fail silently (timer keeps running); telemetry via flag file + notification
StandardOutput=journal
StandardError=journal
