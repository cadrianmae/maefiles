#!/usr/bin/env bash
# nvim-sync — push pending nvim-config changes, pull latest from origin.
#
# Eliminates the need to cd into ~/.config/nvim just to run the git dance.
# Run from anywhere:
#   nvim-sync                 → check status, push if ahead, pull if behind
#   nvim-sync --commit "msg"  → also stage+commit any uncommitted work first
#   nvim-sync --status        → show state (ahead/behind/dirty), do nothing

set -euo pipefail

REPO="$HOME/.config/nvim"
[[ -d "$REPO/.git" ]] || { echo "[ERROR] $REPO is not a git repo" >&2; exit 1; }

COMMIT_MSG=""
STATUS_ONLY=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --commit) COMMIT_MSG="$2"; shift ;;
    --status) STATUS_ONLY=1 ;;
    -h|--help) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "[ERROR] unknown flag: $1" >&2; exit 1 ;;
  esac
  shift
done

cd "$REPO"

# Make sure we have upstream refs
git fetch --quiet

DIRTY=$(git status --porcelain)
AHEAD=$(git rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)
BEHIND=$(git rev-list --count 'HEAD..@{u}' 2>/dev/null || echo 0)

printf '[nvim] dirty=%s  ahead=%d  behind=%d\n' "$( [[ -n "$DIRTY" ]] && echo yes || echo no )" "$AHEAD" "$BEHIND"

if [[ $STATUS_ONLY -eq 1 ]]; then
  exit 0
fi

if [[ -n "$DIRTY" ]]; then
  if [[ -n "$COMMIT_MSG" ]]; then
    git add -A
    git commit -m "$COMMIT_MSG"
    AHEAD=$((AHEAD + 1))
  else
    echo "[WARN] uncommitted changes; re-run with --commit \"msg\" or commit manually"
    git status --short
    exit 1
  fi
fi

if [[ $BEHIND -gt 0 ]]; then
  echo "[pull] rebasing $BEHIND commits from origin"
  git pull --rebase
fi

if [[ $AHEAD -gt 0 ]]; then
  echo "[push] pushing $AHEAD commits to origin"
  git push
fi

echo "[ok] nvim synced"
