#!/bin/bash

# Folder Cleanup Script
# Cleans folders based on configurable criteria like file age, extensions, and size
# Author: Generated by GitHub Copilot
# Date: $(date +%Y-%m-%d)

# Default configuration
DEFAULT_TARGET_DIR="."
DEFAULT_MAX_AGE_DAYS=30
DEFAULT_MIN_SIZE=""
DEFAULT_MAX_SIZE=""
DEFAULT_EXTENSIONS="zip,tar.gz,tgz,tar.bz2,tbz2,tar.xz,txz,7z,rar,deb,rpm,msi,exe,dmg,pkg"
DEFAULT_DRY_RUN=true
DEFAULT_RECURSIVE=false
DEFAULT_VERBOSE=false

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to display help
show_help() {
    cat << EOF
Folder Cleanup Script

USAGE:
    $0 [OPTIONS] [TARGET_DIRECTORY]

OPTIONS:
    -h, --help              Show this help message
    -d, --days DAYS         Delete files older than DAYS (default: $DEFAULT_MAX_AGE_DAYS)
    -e, --extensions EXT    Comma-separated list of extensions to target
                           (default: $DEFAULT_EXTENSIONS)
    -s, --min-size SIZE     Minimum file size (e.g., 100M, 1G)
    -S, --max-size SIZE     Maximum file size (e.g., 100M, 1G)
    -r, --recursive         Search recursively in subdirectories
    -f, --force             Actually delete files (by default, runs in dry-run mode)
    -v, --verbose           Verbose output
    -q, --quiet             Suppress all output except errors

EXAMPLES:
    # Dry run - show what would be deleted
    $0 /path/to/downloads

    # Delete installer files older than 7 days
    $0 -d 7 -e "msi,exe,deb,rpm" -f /path/to/downloads

    # Delete large archive files (>100MB) older than 30 days
    $0 -d 30 -s 100M -e "zip,tar.gz,7z" -f /path/to/archives

    # Recursively clean with verbose output
    $0 -r -v -f /path/to/cleanup

NOTES:
    - By default, the script runs in dry-run mode and shows what would be deleted
    - Use -f/--force to actually delete files
    - File extensions are case-insensitive
    - Size suffixes: K/KB (kilobytes), M/MB (megabytes), G/GB (gigabytes)

EOF
}

# Function to log messages
log() {
    local level="$1"
    shift
    local message="$*"

    if [[ "$QUIET" == true ]]; then
        [[ "$level" == "ERROR" ]] && echo -e "${RED}ERROR: $message${NC}" >&2
        return
    fi

    case "$level" in
        "INFO")
            echo -e "${GREEN}INFO: $message${NC}"
            ;;
        "WARN")
            echo -e "${YELLOW}WARN: $message${NC}"
            ;;
        "ERROR")
            echo -e "${RED}ERROR: $message${NC}" >&2
            ;;
        "DEBUG")
            [[ "$VERBOSE" == true ]] && echo -e "${BLUE}DEBUG: $message${NC}"
            ;;
        *)
            echo "$message"
            ;;
    esac
}

# Function to convert size to bytes
size_to_bytes() {
    local size="$1"
    local number=$(echo "$size" | sed 's/[^0-9.]//g')
    local unit=$(echo "$size" | sed 's/[0-9.]//g' | tr '[:lower:]' '[:upper:]')

    case "$unit" in
        "K"|"KB")
            echo $(echo "$number * 1024" | bc 2>/dev/null || echo "0")
            ;;
        "M"|"MB")
            echo $(echo "$number * 1024 * 1024" | bc 2>/dev/null || echo "0")
            ;;
        "G"|"GB")
            echo $(echo "$number * 1024 * 1024 * 1024" | bc 2>/dev/null || echo "0")
            ;;
        "")
            echo "$number"
            ;;
        *)
            log "ERROR" "Invalid size unit: $unit. Use K/KB, M/MB, or G/GB"
            return 1
            ;;
    esac
}

# Function to check if file matches extension criteria
matches_extension() {
    local file="$1"
    local extensions="$2"

    if [[ -z "$extensions" ]]; then
        return 0  # No extension filter, match all
    fi

    local filename=$(basename "$file")
    local file_ext=""

    # Handle compound extensions like .tar.gz
    if [[ "$filename" =~ \.(tar\.gz|tar\.bz2|tar\.xz)$ ]]; then
        file_ext="${BASH_REMATCH[1]}"
    else
        file_ext="${filename##*.}"
    fi

    # Convert to lowercase for comparison
    file_ext=$(echo "$file_ext" | tr '[:upper:]' '[:lower:]')

    # Check if extension matches any in the list
    IFS=',' read -ra EXT_ARRAY <<< "$(echo "$extensions" | tr '[:upper:]' '[:lower:]')"
    for ext in "${EXT_ARRAY[@]}"; do
        ext=$(echo "$ext" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')  # trim whitespace
        if [[ "$file_ext" == "$ext" ]]; then
            return 0
        fi
    done

    return 1
}

# Function to check if file matches size criteria
matches_size() {
    local file="$1"
    local min_size="$2"
    local max_size="$3"

    local file_size=$(stat -c%s "$file" 2>/dev/null || echo "0")

    if [[ -n "$min_size" ]]; then
        local min_bytes=$(size_to_bytes "$min_size")
        if [[ "$file_size" -lt "$min_bytes" ]]; then
            return 1
        fi
    fi

    if [[ -n "$max_size" ]]; then
        local max_bytes=$(size_to_bytes "$max_size")
        if [[ "$file_size" -gt "$max_bytes" ]]; then
            return 1
        fi
    fi

    return 0
}

# Function to format file size for display
format_size() {
    local bytes="$1"
    if (( bytes >= 1073741824 )); then
        echo "$(echo "scale=2; $bytes / 1073741824" | bc)GB"
    elif (( bytes >= 1048576 )); then
        echo "$(echo "scale=2; $bytes / 1048576" | bc)MB"
    elif (( bytes >= 1024 )); then
        echo "$(echo "scale=2; $bytes / 1024" | bc)KB"
    else
        echo "${bytes}B"
    fi
}

# Function to clean folder
clean_folder() {
    local target_dir="$1"
    local max_age_days="$2"
    local extensions="$3"
    local min_size="$4"
    local max_size="$5"
    local recursive="$6"
    local dry_run="$7"

    if [[ ! -d "$target_dir" ]]; then
        log "ERROR" "Directory does not exist: $target_dir"
        return 1
    fi

    log "INFO" "Scanning directory: $target_dir"
    log "DEBUG" "Max age: $max_age_days days"
    log "DEBUG" "Extensions: ${extensions:-"all files"}"
    log "DEBUG" "Min size: ${min_size:-"none"}"
    log "DEBUG" "Max size: ${max_size:-"none"}"
    log "DEBUG" "Recursive: $recursive"
    log "DEBUG" "Dry run: $dry_run"

    local find_cmd="find '$target_dir'"

    # Add recursion option
    if [[ "$recursive" != true ]]; then
        find_cmd="$find_cmd -maxdepth 1"
    fi

    # Add age filter
    find_cmd="$find_cmd -type f -mtime +$max_age_days"

    local deleted_count=0
    local deleted_size=0

    # Execute find and process results
    while IFS= read -r -d '' file; do
        # Skip if file doesn't exist (race condition)
        [[ ! -f "$file" ]] && continue

        # Check extension filter
        if ! matches_extension "$file" "$extensions"; then
            log "DEBUG" "Skipping $file (extension mismatch)"
            continue
        fi

        # Check size filter
        if ! matches_size "$file" "$min_size" "$max_size"; then
            log "DEBUG" "Skipping $file (size mismatch)"
            continue
        fi

        # Get file info
        local file_size=$(stat -c%s "$file" 2>/dev/null || echo "0")
        local file_date=$(stat -c%y "$file" 2>/dev/null || echo "unknown")
        local formatted_size=$(format_size "$file_size")

        if [[ "$dry_run" == true ]]; then
            echo "Would delete: $file ($formatted_size, modified: ${file_date%.*})"
        else
            log "INFO" "Deleting: $file ($formatted_size)"
            if rm "$file" 2>/dev/null; then
                ((deleted_count++))
                ((deleted_size += file_size))
            else
                log "ERROR" "Failed to delete: $file"
            fi
        fi
    done < <(eval "$find_cmd -print0")

    if [[ "$dry_run" == true ]]; then
        log "INFO" "Dry run completed. Use -f/--force to actually delete files."
    else
        local total_size=$(format_size "$deleted_size")
        log "INFO" "Cleanup completed. Deleted $deleted_count files ($total_size total)."
    fi
}

# Initialize variables with defaults
TARGET_DIR="$DEFAULT_TARGET_DIR"
MAX_AGE_DAYS="$DEFAULT_MAX_AGE_DAYS"
EXTENSIONS="$DEFAULT_EXTENSIONS"
MIN_SIZE="$DEFAULT_MIN_SIZE"
MAX_SIZE="$DEFAULT_MAX_SIZE"
DRY_RUN="$DEFAULT_DRY_RUN"
RECURSIVE="$DEFAULT_RECURSIVE"
VERBOSE="$DEFAULT_VERBOSE"
QUIET=false

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_help
            exit 0
            ;;
        -d|--days)
            MAX_AGE_DAYS="$2"
            shift 2
            ;;
        -e|--extensions)
            EXTENSIONS="$2"
            shift 2
            ;;
        -s|--min-size)
            MIN_SIZE="$2"
            shift 2
            ;;
        -S|--max-size)
            MAX_SIZE="$2"
            shift 2
            ;;
        -r|--recursive)
            RECURSIVE=true
            shift
            ;;
        -f|--force)
            DRY_RUN=false
            shift
            ;;
        -v|--verbose)
            VERBOSE=true
            shift
            ;;
        -q|--quiet)
            QUIET=true
            shift
            ;;
        -*)
            log "ERROR" "Unknown option: $1"
            echo "Use -h or --help for usage information."
            exit 1
            ;;
        *)
            TARGET_DIR="$1"
            shift
            ;;
    esac
done

# Validate numeric arguments
if ! [[ "$MAX_AGE_DAYS" =~ ^[0-9]+$ ]]; then
    log "ERROR" "Days must be a positive integer: $MAX_AGE_DAYS"
    exit 1
fi

# Check for required commands
for cmd in find stat bc; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        log "ERROR" "Required command not found: $cmd"
        exit 1
    fi
done

# Show banner
if [[ "$QUIET" != true ]]; then
    echo -e "${BLUE}========================================${NC}"
    echo -e "${BLUE}       Folder Cleanup Script${NC}"
    echo -e "${BLUE}========================================${NC}"
    echo
fi

# Validate target directory
if [[ ! -d "$TARGET_DIR" ]]; then
    log "ERROR" "Target directory does not exist: $TARGET_DIR"
    exit 1
fi

# Convert relative path to absolute
TARGET_DIR=$(realpath "$TARGET_DIR")

# Show configuration
if [[ "$VERBOSE" == true ]]; then
    log "INFO" "Configuration:"
    log "INFO" "  Target directory: $TARGET_DIR"
    log "INFO" "  Max age: $MAX_AGE_DAYS days"
    log "INFO" "  Extensions: ${EXTENSIONS:-"all files"}"
    log "INFO" "  Min size: ${MIN_SIZE:-"none"}"
    log "INFO" "  Max size: ${MAX_SIZE:-"none"}"
    log "INFO" "  Recursive: $RECURSIVE"
    log "INFO" "  Dry run: $DRY_RUN"
    echo
fi

# Warn about dry run mode
if [[ "$DRY_RUN" == true ]] && [[ "$QUIET" != true ]]; then
    log "WARN" "Running in dry-run mode. No files will be deleted."
    log "WARN" "Use -f or --force to actually delete files."
    echo
fi

# Execute cleanup
clean_folder "$TARGET_DIR" "$MAX_AGE_DAYS" "$EXTENSIONS" "$MIN_SIZE" "$MAX_SIZE" "$RECURSIVE" "$DRY_RUN"

exit $?
