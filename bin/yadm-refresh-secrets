#!/usr/bin/env bash
# yadm-refresh-secrets — interactive BWS → pass resync
#
# Three modes:
#   default           refresh only stale entries (per yadm-check-staleness)
#   --all             force refresh of every manifest entry
#   --only <pattern>  refresh entries whose pass path or env name matches pattern
#
# This script delegates to .config/yadm/bootstrap with FORCE_ALL/ONLY_MATCH env
# to avoid duplicating the BWS-handling logic.

set -euo pipefail

# shellcheck source=/dev/null
source "$HOME/lib/runlib.sh"

FORCE_ALL=0
ONLY_MATCH=""
NOTIFY_ONLY=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --all)           FORCE_ALL=1 ;;
    --only)          ONLY_MATCH="$2"; shift ;;
    --notify-only)   NOTIFY_ONLY=1 ;;
    *) error "unknown flag: $1"; exit 1 ;;
  esac
  shift
done

# --notify-only: used by systemd timer. No interactive work; just warn.
if [[ $NOTIFY_ONLY -eq 1 ]]; then
  exec "$HOME/bin/yadm-check-staleness" --notify --quiet
fi

# Non-interactive stale check first to decide scope
if [[ $FORCE_ALL -eq 0 && -z "$ONLY_MATCH" ]]; then
  if "$HOME/bin/yadm-check-staleness" --quiet; then
    ok "nothing to refresh"
    exit 0
  fi
  # Something IS stale, so this run must overwrite. bootstrap step 5 skips any
  # pass entry that already exists unless FORCE_ALL is set -- without this the
  # default path could only ever SEED missing entries, never refresh rotated
  # ones, and reported "already exists — skipping" for the very secrets it was
  # invoked to update.
  warn "stale entries detected — forcing refresh of all manifest entries"
  FORCE_ALL=1
fi

# Delegate to bootstrap with resync intent
args=()
[[ $FORCE_ALL -eq 1 ]] && args+=(--all)
[[ -n "$ONLY_MATCH" ]] && args+=(--only "$ONLY_MATCH")

exec bash "$HOME/.config/yadm/bootstrap" "${args[@]}"
