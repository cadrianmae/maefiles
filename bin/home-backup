#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["rich", "pexpect"]
# ///
"""Back up $HOME to Proton Drive.

Two kinds of data, handled differently:

  PLAIN    Large, already-compressed media. Uploaded as files so Proton can
           resume per-file and one photo can be restored without unpacking
           90G. Compression measured 1.4-3.6% here, so archiving is overhead.

  ARCHIVE  Everything else: configs, dotfiles, code, documents, saves.
           Thousands of small files compressing 10-87%. Bundled into split
           tar.zst so the upload is a handful of 2G parts, not a million PUTs.

    home-backup stage      build archives into ~/backup-staging
    home-backup upload     push staging + plain dirs to Proton Drive
    home-backup verify     name every local file missing from the remote
    home-backup status     what exists locally and remotely
    home-backup logs       past runs, and files that never reached the remote
    home-backup eta        throughput and finish time

Safe to interrupt and re-run: archives are skipped if already built, and
uploads skip files whose content already matches.

Why this is Python rather than the earlier bash
-----------------------------------------------
proton-drive does not print lines. It redraws a block by counting the lines it
wrote, moving the cursor up that many times, and clearing each. That count
depends on the exact terminal width, so anything between it and the terminal
that changes line lengths makes it erase the wrong lines and the screen goes
blank. Three filters were tried in bash and all three failed: tee killed its
isatty check, awk buffered past \\r, and a clipper broke the cursor arithmetic.

So its output is never relayed. The CLI runs on its own pty, every byte is
consumed here, and the display is rendered from parsed values.

The CLI still does the work: transfer, encryption, auth, per-file resume.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
from collections import deque
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass, field
from pathlib import Path

import pexpect
from rich.console import Console, Group
from rich.live import Live
from rich.panel import Panel
from rich.progress import (
    BarColumn,
    Progress,
    SpinnerColumn,
    TaskProgressColumn,
    TextColumn,
    TimeRemainingColumn,
)
from rich.table import Table
from rich.text import Text

# --- configuration -----------------------------------------------------------

HOME = Path.home()
PD = HOME / ".local/bin/proton-drive"
STAGING = HOME / "backup-staging"
REMOTE_ROOT = "/my-files"
REMOTE_NAME = "backup-2026-08-03"
REMOTE = f"{REMOTE_ROOT}/{REMOTE_NAME}"

SPLIT_SIZE = "2G"
PART_PREFIX = "home.tar.zst.part-"
# Written only after the archive is read back and counted. Its absence means
# the parts may be a truncated tar stream that would restore silently wrong.
COMPLETE_MARKER = STAGING / ".archive-complete"

PLAIN_DIRS = ["Pictures", "Videos", "Music", "Games", "Downloads"]

# Never backed up. Every one is regenerated by the tool that owns it.
EXCLUDES = [
    # Re-downloadable from Steam. Saves (userdata) and Windows-game prefixes
    # (compatdata) are NOT here and ARE backed up.
    ".local/share/Steam/steamapps/common",
    ".local/share/Steam/steamapps/shadercache",
    # Launcher-managed. PrismLauncher *instances*, including all 29 worlds,
    # live elsewhere and are backed up.
    ".local/share/PrismLauncher/assets",
    ".local/share/PrismLauncher/cache",
    ".local/share/PrismLauncher/libraries",
    ".local/share/lutris/runners",
    ".local/share/lutris/runtime",
    # OSTree object store, rebuilt from flathub. App *data* in .var/app/* is
    # kept; only the per-app caches are dropped.
    ".local/share/flatpak/repo",
    ".var/app/*/cache",
    # Regenerates by definition.
    ".cache",
    ".local/share/Trash",
    # Would archive its own output.
    "backup-staging",
]

LOG_DIR = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "home-backup"
FAILURES = LOG_DIR / "failures.tsv"

# The CLI hangs for minutes at a time and then resumes by itself. Measured on
# 2026-08-05: 14 KB/s across 2 connections while hung, 501 KB/s across 8 once
# it recovered, with no error raised either way. A 180s threshold fired at
# 331s on a hang that cleared on its own, so this only warns well past the
# point where recovery is still plausible.
STALL_SECONDS = 900
# Long enough to be worth saying something, short enough to notice.
STALL_NOTICE_SECONDS = 240

# Listing is read-only, so unlike uploading it is safe to run concurrently.
# One call per folder at ~0.9s serial makes verify a 3-hour job; this is the
# single biggest cost in the tool.
LIST_WORKERS = 8

console = Console()

# --- CLI output parsing -------------------------------------------------------
# Two lines carry everything, both stable across every observed run:
#
#   ⠋ 83.27% Lightroom Catalog-v10.lrcat.zip (23.90 MiB)
#   Uploaded 459 | Failed 3 | Skipped 4452 | Queued 3195

RE_PROGRESS = re.compile(r"(\d+(?:\.\d+)?)%\s+(.+?)\s+\(([\d.]+\s*[KMGT]?i?B)\)\s*$")

# Fields are omitted when zero. transferSummary.ts:44 builds the line as
# ["Uploaded n"], pushes "Failed n" only if failures exist and "Skipped n" only
# if skips exist, then always "Queued n". So a fresh directory prints just
# "Uploaded 0 | Queued 383". Requiring all four fields matched nothing until a
# directory happened to have both skips and failures.
RE_COUNT_LINE = re.compile(r"\b(?:Uploaded|Downloaded)\s+\d+\b.*\bQueued\s+\d+\b")
RE_FIELD = {
    "uploaded": re.compile(r"\b(?:Uploaded|Downloaded)\s+(\d+)\b"),
    "failed": re.compile(r"\bFailed\s+(\d+)\b"),
    "skipped": re.compile(r"\bSkipped\s+(\d+)\b"),
    "queued": re.compile(r"\bQueued\s+(\d+)\b"),
}


def parse_counters(line: str) -> dict[str, int] | None:
    """Pull the counter fields out of a progress line, absent meaning zero."""
    if not RE_COUNT_LINE.search(line):
        return None
    out = {}
    for key, rx in RE_FIELD.items():
        m = rx.search(line)
        out[key] = int(m.group(1)) if m else 0
    return out
RE_ANSI = re.compile(r"\x1b\[[0-9;?]*[a-zA-Z]|\x1b\][^\a]*\a")


def strip_ansi(s: str) -> str:
    return RE_ANSI.sub("", s)


class CountsColumn(TextColumn):
    """File counts, tolerating a total that is not known yet.

    The CLI only emits its counter line periodically, so at the start of a
    directory there is no total. A plain format string renders that as
    "0/None files".
    """

    def __init__(self) -> None:
        super().__init__("")

    def render(self, task) -> Text:
        if task.total is None:
            return Text("counting...", style="dim")
        return Text(f"{int(task.completed)}/{int(task.total)} files")


def human(n: float) -> str:
    for unit in ("B", "K", "M", "G", "T"):
        if abs(n) < 1024:
            return f"{n:.0f}{unit}" if unit == "B" else f"{n:.1f}{unit}"
        n /= 1024
    return f"{n:.1f}P"


def human_rate(bps: float | None) -> str:
    if bps is None:
        return "measuring..."
    mb = bps / 1_048_576
    return f"{mb:.2f} MB/s" if mb >= 0.01 else f"{bps / 1024:.0f} KB/s"


def fmt_dur(seconds: float | None) -> str:
    if seconds is None or seconds < 0:
        return "--"
    s = int(seconds)
    return f"{s // 3600}h{(s % 3600) // 60:02d}m"


# --- remote access ------------------------------------------------------------


def pd_json(args: list[str], retries: int = 3) -> tuple[bool, list[dict]]:
    """Run a proton-drive command with --json. Returns (succeeded, rows).

    The success flag is not decoration. An earlier version returned a bare
    list and used [] for every outcome, so a failed listing was
    indistinguishable from an empty folder. In a parallel walk each silent
    failure prunes a whole subtree, and every file beneath it is then reported
    missing: 3418 false 'missing' on Pictures, all of them under one .lrdata
    tree that was present on the remote the whole time.

    Everything reads --json. The human-readable output was parsed once with
    `awk '{print $NF}'`, which keeps only the text after the last space, so
    every filename containing a space was reported missing.
    """
    for attempt in range(retries):
        try:
            out = subprocess.run(
                [str(PD), *args, "--json"],
                capture_output=True, text=True, timeout=300,
            )
        except (subprocess.TimeoutExpired, OSError):
            time.sleep(1 + 2 * attempt)
            continue
        if out.returncode == 0:
            body = out.stdout.strip()
            if not body:
                return True, []
            try:
                data = json.loads(body)
            except json.JSONDecodeError:
                time.sleep(1 + 2 * attempt)
                continue
            return True, (data if isinstance(data, list) else [])
        time.sleep(1 + 2 * attempt)
    return False, []


def remote_escape(name: str) -> str:
    """Remote paths escape / inside a node name with a backslash."""
    return name.replace("/", "\\/")


def remote_list(path: str, kind: str | None = None) -> tuple[bool, list[dict]]:
    args = ["filesystem", "list"]
    if kind:
        args += ["-t", kind]
    args.append(path)
    return pd_json(args)


def remote_list_rows(path: str, kind: str | None = None) -> list[dict]:
    """Rows only, for callers where a failed listing is not load-bearing."""
    return remote_list(path, kind)[1]


@dataclass
class Walk:
    files: set[str] = field(default_factory=set)
    unreadable: list[str] = field(default_factory=list)   # listings that failed
    undecryptable: int = 0

    @property
    def complete(self) -> bool:
        return not self.unreadable


def remote_walk(base: str, progress: Progress | None = None, task=None) -> Walk:
    """Every file under `base`, as paths relative to it.

    `filesystem list` has no recursive flag, so recursion happens here. Folders
    are fanned out across a thread pool because each call is a ~0.9s round trip
    and a tree like Lightroom's preview cache has thousands.

    Folders whose listing fails are recorded rather than skipped. A caller must
    not conclude anything about missing files from an incomplete walk.
    """
    walk = Walk()
    frontier = [(base, "")]

    with ThreadPoolExecutor(max_workers=LIST_WORKERS) as pool:
        while frontier:
            results = list(pool.map(lambda fp: (fp, remote_list(fp[0])), frontier))
            frontier = []
            for (path, prefix), (ok, entries) in results:
                if not ok:
                    walk.unreadable.append(path)
                    continue
                for e in entries:
                    name = e.get("name") or {}
                    if not name.get("ok"):
                        walk.undecryptable += 1
                        continue
                    value = name["value"]
                    if e.get("type") == "folder":
                        frontier.append(
                            (f"{path}/{remote_escape(value)}", f"{prefix}{value}/")
                        )
                    elif e.get("type") == "file":
                        walk.files.add(f"{prefix}{value}")
            if progress is not None and task is not None:
                progress.update(
                    task, completed=len(walk.files),
                    description=f"listing remote ({len(frontier)} folders queued)",
                )

    if walk.undecryptable:
        console.print(
            f"[yellow][WARN] {walk.undecryptable} remote node(s) had "
            f"undecryptable names and could not be matched[/yellow]"
        )
    return walk


def remote_part_count() -> int:
    return sum(
        1 for e in remote_list_rows(REMOTE, "file")
        if (e.get("name") or {}).get("ok")
        and e["name"]["value"].startswith(PART_PREFIX)
    )


def remote_bytes() -> int:
    """Exact bytes at the remote root.

    Sums totalStorageSize rather than parsing the human-readable column, which
    both rounded and depended on the size sitting a fixed number of fields from
    the end of the line.
    """
    return sum(
        e.get("totalStorageSize") or 0
        for e in remote_list_rows(REMOTE, "file")
    )


# --- local state --------------------------------------------------------------


def local_parts() -> list[Path]:
    return sorted(STAGING.glob(f"{PART_PREFIX}*"))


def dir_bytes(path: Path) -> int:
    total = 0
    for root, _dirs, names in os.walk(path, onerror=lambda e: None):
        for n in names:
            try:
                total += os.lstat(os.path.join(root, n)).st_size
            except OSError:
                pass
    return total


def planned_bytes() -> int:
    total = dir_bytes(STAGING) if STAGING.is_dir() else 0
    for d in PLAIN_DIRS:
        p = HOME / d
        if p.is_dir():
            total += dir_bytes(p)
    return total


# --- throughput ---------------------------------------------------------------


class Rate:
    """Throughput off the default route, over a rolling window.

    A cumulative average was tried first and produced an ETA of 100,000 hours
    after a slow patch, because early samples never age out.
    """

    def __init__(self, window: float = 60.0) -> None:
        self.window = window
        self.samples: deque[tuple[float, int]] = deque()
        self.iface = self._default_iface()

    @staticmethod
    def _default_iface() -> str | None:
        try:
            with open("/proc/net/route") as fh:
                for line in fh.readlines()[1:]:
                    parts = line.split()
                    if len(parts) > 1 and parts[1] == "00000000":
                        return parts[0]
        except OSError:
            pass
        return None

    def _tx(self) -> int | None:
        if not self.iface:
            return None
        try:
            return int(
                Path(f"/sys/class/net/{self.iface}/statistics/tx_bytes").read_text()
            )
        except (OSError, ValueError):
            return None

    def sample(self) -> None:
        tx = self._tx()
        if tx is None:
            return
        now = time.monotonic()
        self.samples.append((now, tx))
        while self.samples and now - self.samples[0][0] > self.window:
            self.samples.popleft()

    def bytes_per_sec(self) -> float | None:
        if len(self.samples) < 2:
            return None
        (t0, b0), (t1, b1) = self.samples[0], self.samples[-1]
        if t1 - t0 < 5:
            return None
        return max(0.0, (b1 - b0) / (t1 - t0))


# --- journal ------------------------------------------------------------------


class Connections:
    """Count the child's established TCP connections.

    Worth showing: during a hang the CLI sits on 2 connections at ~14 KB/s,
    and on recovery it opens 8 and jumps to ~500 KB/s. The count moves before
    the throughput does, so it is the earliest signal of which state it is in.

    Sockets are matched by inode — the pid's fds give the inodes it owns, and
    /proc/net/tcp gives the state of each. No root needed.
    """

    def __init__(self, pid: int, interval: float = 1.0) -> None:
        self.pid = pid
        self.interval = interval
        self._last = 0.0
        self._count = 0

    def _inodes(self) -> set[str]:
        found = set()
        try:
            for fd in os.scandir(f"/proc/{self.pid}/fd"):
                try:
                    target = os.readlink(fd.path)
                except OSError:
                    continue
                if target.startswith("socket:["):
                    found.add(target[8:-1])
        except OSError:
            pass
        return found

    def count(self) -> int:
        now = time.monotonic()
        if now - self._last < self.interval:
            return self._count
        self._last = now

        mine = self._inodes()
        if not mine:
            self._count = 0
            return 0

        total = 0
        for proto in ("tcp", "tcp6"):
            try:
                lines = Path(f"/proc/net/{proto}").read_text().splitlines()[1:]
            except OSError:
                continue
            for line in lines:
                f = line.split()
                # st == 01 is ESTABLISHED; field 9 is the socket inode.
                if len(f) > 9 and f[3] == "01" and f[9] in mine:
                    total += 1
        self._count = total
        return total


class Journal:
    """Append-only record, so a wedge stays diagnosable after the fact."""

    def __init__(self, path: Path) -> None:
        self.path = path
        path.parent.mkdir(parents=True, exist_ok=True)
        self.fh = path.open("a", encoding="utf-8")

    def write(self, **fields) -> None:
        fields["ts"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
        self.fh.write(json.dumps(fields) + "\n")
        self.fh.flush()

    def close(self) -> None:
        try:
            self.fh.close()
        except OSError:
            pass


# --- upload -------------------------------------------------------------------


@dataclass
class DirState:
    name: str
    uploaded: int = 0
    failed: int = 0
    skipped: int = 0
    queued: int = 0
    current_file: str = ""
    current_size: str = ""
    current_pct: float = 0.0
    # Most files upload in one block, so 0.00% is the only percentage the CLI
    # ever prints for them: 63,867 frames across two logs, one distinct value.
    # A bar is only worth drawing once a real percentage has appeared.
    saw_real_pct: bool = False
    started: float = field(default_factory=time.monotonic)
    last_change: float = field(default_factory=time.monotonic)
    _fingerprint: tuple = ()

    @property
    def total(self) -> int:
        return self.uploaded + self.failed + self.skipped + self.queued

    @property
    def done(self) -> int:
        return self.uploaded + self.failed + self.skipped

    @property
    def stalled_for(self) -> float:
        return time.monotonic() - self.last_change

    def note_activity(self) -> None:
        """Reset the stall clock only when something genuinely moved.

        The spinner keeps animating while wedged, so a new frame is not
        evidence of progress. Only the counters or the percentage count.
        """
        fp = (
            self.uploaded, self.failed, self.skipped,
            self.current_pct, self.current_file,
        )
        if fp != self._fingerprint:
            self._fingerprint = fp
            self.last_change = time.monotonic()


def _upload_panel(state: DirState, rate: Rate, overall, current, conns=None) -> Group:
    counters = Table.grid(padding=(0, 2))
    counters.add_row(
        Text("uploaded", style="dim"), Text(str(state.uploaded), style="green"),
        Text("skipped", style="dim"), Text(str(state.skipped)),
        Text("failed", style="dim"),
        Text(str(state.failed), style="red" if state.failed else "dim"),
        Text("queued", style="dim"), Text(str(state.queued)),
    )
    n = conns.count() if conns else 0
    status = Text.assemble(
        ("rate  ", "dim"), (human_rate(rate.bytes_per_sec()), "cyan"),
        ("    conns  ", "dim"),
        # Few connections alongside a low rate is the hang signature.
        (str(n), "yellow" if n <= 2 else "cyan"),
    )

    # Only draw the per-file bar when the CLI is actually reporting movement
    # within the file; otherwise say what is in flight and leave it at that.
    if state.saw_real_pct:
        current_row = current
    else:
        current_row = Text.assemble(
            ("sending  ", "dim"),
            (state.current_file or "waiting...", "white"),
            (f"  {state.current_size}" if state.current_size else "", "dim"),
        )

    body = [overall, current_row, counters, status]
    if state.stalled_for > STALL_SECONDS:
        body.append(
            Text(
                f"[WARN] no progress for {fmt_dur(state.stalled_for)} on "
                f"{state.current_file or '?'} — past the point where these "
                f"usually clear. Ctrl-C is safe; completed files are skipped.",
                style="bold yellow",
            )
        )
    elif state.stalled_for > STALL_NOTICE_SECONDS:
        # These clear by themselves. Saying so stops a recovering transfer
        # from being killed in the belief that it is dead.
        body.append(
            Text(
                f"[INFO] paused {int(state.stalled_for)}s on "
                f"{state.current_file or '?'} — the CLI does this and resumes "
                f"on its own. Leave it.",
                style="dim yellow",
            )
        )
    return Group(
        Panel(Group(*body), title=f"uploading {state.name}", border_style="blue")
    )


def upload_one(target: Path, label: str, journal: Journal) -> tuple[int, DirState]:
    """Run the CLI against one local path. Returns (exit status, state)."""
    # -f skip   file conflict: content already on the remote is not re-sent
    # -d merge  descend into folders that already exist
    #
    # Do NOT use -c. It sets the FOLDER strategy too, so once a directory
    # exists remotely the whole tree below it is skipped while the CLI still
    # reports success. That silently left 88G unbacked-up on 2026-08-04.
    argv = ["filesystem", "upload", "-f", "skip", "-d", "merge", str(target), REMOTE]

    state = DirState(name=label)
    rate = Rate()
    journal.write(event="start", target=str(target), label=label)

    # console= matters: without it rich builds each Progress its own global
    # Console, so two Consoles end up writing to the same terminal and the
    # panel header is redrawn instead of updated in place — eight stacked
    # "uploading Downloads" borders in one run.
    overall = Progress(
        TextColumn("[bold blue]{task.description}"),
        BarColumn(bar_width=None),
        TaskProgressColumn(),
        CountsColumn(),
        TimeRemainingColumn(),
        expand=True,
        console=console,
        auto_refresh=False,   # Live drives the refresh; a second timer duplicates frames
    )
    current = Progress(
        TextColumn("[dim]{task.description}"),
        BarColumn(bar_width=30, complete_style="cyan"),
        TaskProgressColumn(),
        expand=True,
        console=console,
        auto_refresh=False,
    )
    t_overall = overall.add_task(label, total=None)
    t_current = current.add_task("waiting...", total=100)

    child = pexpect.spawn(
        str(PD), argv,
        encoding="utf-8", codec_errors="replace", timeout=None,
        dimensions=(40, 200),   # its own pty; none of this reaches the screen
    )

    conns = Connections(child.pid)
    buf = ""
    try:
        with Live(
            _upload_panel(state, rate, overall, current, conns),
            console=console, refresh_per_second=8,
        ) as live:
            while True:
                try:
                    chunk = child.read_nonblocking(size=4096, timeout=0.25)
                except pexpect.TIMEOUT:
                    chunk = ""
                except (pexpect.EOF, OSError):
                    break

                buf += chunk
                while (m := re.search(r"[\r\n]", buf)) is not None:
                    line, buf = buf[: m.start()], buf[m.end():]
                    line = strip_ansi(line).strip()
                    if not line:
                        continue
                    if (c := parse_counters(line)) is not None:
                        state.uploaded = c["uploaded"]
                        state.failed = c["failed"]
                        state.skipped = c["skipped"]
                        state.queued = c["queued"]
                        overall.update(
                            t_overall, total=state.total, completed=state.done
                        )
                    elif mp := RE_PROGRESS.search(line):
                        pct = float(mp.group(1))
                        if mp.group(2) != state.current_file:
                            state.saw_real_pct = False   # new file, new verdict
                        state.current_pct = pct
                        state.current_file = mp.group(2)
                        state.current_size = mp.group(3)
                        if pct > 0:
                            state.saw_real_pct = True
                        current.update(
                            t_current,
                            description=mp.group(2)[:60],
                            completed=pct,
                        )
                    state.note_activity()

                rate.sample()
                live.update(_upload_panel(state, rate, overall, current, conns))
                if not child.isalive():
                    break
    finally:
        if child.isalive():
            child.terminate(force=True)
        child.close()

    journal.write(
        event="end", label=label,
        uploaded=state.uploaded, failed=state.failed,
        skipped=state.skipped, queued=state.queued,
        seconds=round(time.monotonic() - state.started, 1),
    )
    tag = "[OK]" if state.failed == 0 else "[WARN]"
    console.print(
        f"{tag} {label}: {state.uploaded} uploaded, {state.skipped} skipped, "
        f"{state.failed} failed"
    )
    return (child.exitstatus or 0), state


def cmd_upload(args) -> int:
    if not PD.is_file():
        console.print(f"[red]proton-drive CLI not found at {PD}[/red]")
        return 1
    if not remote_list(REMOTE_ROOT)[0]:
        console.print(f"[red]Not authenticated. Run: {PD} auth login[/red]")
        return 1

    dirs = args.dirs or PLAIN_DIRS
    unknown = [d for d in dirs if d not in PLAIN_DIRS]
    if unknown:
        console.print(f"[red]unknown directory: {', '.join(unknown)}[/red]")
        console.print(f"known: {', '.join(PLAIN_DIRS)}")
        return 2

    journal = Journal(LOG_DIR / f"{time.strftime('%Y%m%d-%H%M%S')}-upload.jsonl")
    subprocess.run(
        [str(PD), "filesystem", "create-folder", REMOTE_ROOT, REMOTE_NAME],
        capture_output=True,
    )

    console.print(f"[bold]remote:[/bold] {REMOTE}")
    console.print(f"[bold]dirs:[/bold]   {', '.join(dirs)}\n")

    rc = 0
    try:
        # Archive first: it is the irreplaceable half of the backup.
        if not args.dirs and STAGING.is_dir() and local_parts():
            if not COMPLETE_MARKER.exists():
                console.print(
                    "[red]refusing to upload staging: no .archive-complete "
                    "marker.[/red] The parts may be a truncated tar stream. "
                    "Re-run `home-backup stage`."
                )
                return 1
            staged = {p.name for p in STAGING.iterdir() if not p.name.startswith(".")}
            on_remote = {
                e["name"]["value"] for e in remote_list_rows(REMOTE, "file")
                if (e.get("name") or {}).get("ok")
            }
            if staged - on_remote:
                rc, _ = upload_one(STAGING, "archive", journal)
            else:
                console.print(
                    f"[dim]archive: all {len(staged)} staged files already on "
                    f"remote — skipping[/dim]"
                )

        for d in dirs:
            local = HOME / d
            if not local.is_dir():
                console.print(f"[dim]skip (absent): {d}[/dim]")
                continue
            status, _ = upload_one(local, d, journal)
            rc = status or rc
    except KeyboardInterrupt:
        console.print(
            "\n[yellow]Interrupted.[/yellow] Nothing is corrupted: the CLI "
            "only publishes complete files.\n"
            f"  {remote_part_count()} of 50 archive parts are on the remote.\n"
            "  Re-run to continue; files already uploaded are skipped."
        )
        journal.write(event="interrupted")
        return 130
    finally:
        journal.close()

    console.print(f"\n[dim]journal: {journal.path}[/dim]")
    return rc


# --- stage --------------------------------------------------------------------


def cmd_stage(args) -> int:
    if COMPLETE_MARKER.exists() and local_parts():
        console.print(
            f"[green][OK][/green] archive already staged: "
            f"{len(local_parts())} parts, verified."
        )
        console.print("  Delete .archive-complete to force a rebuild.")
        return 0

    if local_parts():
        console.print(
            "[yellow][WARN][/yellow] partial parts present with no completion "
            "marker. Re-staging discards them — there is no safe way to resume "
            "a half-written tar stream."
        )
        if not args.force:
            console.print("  Re-run with --force to start over.")
            return 1
        for p in local_parts():
            p.unlink()

    STAGING.mkdir(parents=True, exist_ok=True)
    journal = Journal(LOG_DIR / f"{time.strftime('%Y%m%d-%H%M%S')}-stage.jsonl")

    excludes = [f"--exclude=./{e}" for e in (*EXCLUDES, *PLAIN_DIRS)]
    tar_cmd = [
        "tar", "-cf", "-", "-C", str(HOME),
        "--ignore-failed-read", "--warning=no-file-changed",
        *excludes, ".",
    ]
    journal.write(event="stage_start", excludes=len(excludes))
    console.print("[bold]Building archive[/bold] (tar | zstd -3 | split)\n")

    tar = subprocess.Popen(tar_cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    zstd = subprocess.Popen(
        ["zstd", "-3", "-T0"], stdin=tar.stdout,
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
    )
    tar.stdout.close()
    split = subprocess.Popen(
        ["split", "-b", SPLIT_SIZE, "-", str(STAGING / PART_PREFIX)],
        stdin=zstd.stdout, stderr=subprocess.DEVNULL,
    )
    zstd.stdout.close()

    progress = Progress(
        SpinnerColumn(), TextColumn("{task.description}"),
        TextColumn("[cyan]{task.fields[size]}"), console=console,
    )
    with progress:
        task = progress.add_task("archiving", size="0B")
        while split.poll() is None:
            time.sleep(1)
            progress.update(
                task,
                size=f"{human(sum(p.stat().st_size for p in local_parts()))} "
                     f"in {len(local_parts())} parts",
            )

    rcs = (tar.wait(), zstd.wait(), split.wait())
    if any(rcs):
        console.print(f"[red]archive failed[/red] (tar/zstd/split exit {rcs})")
        journal.write(event="stage_failed", codes=rcs)
        journal.close()
        return 1

    # Read the archive back before trusting it. Checking that parts merely
    # exist would have shipped a truncated 281M archive as complete.
    console.print("\n[bold]Verifying archive[/bold] (reading every entry back)")
    entries = 0
    with progress:
        task = progress.add_task("verifying", size="0 entries")
        cat = subprocess.Popen(
            ["cat", *[str(p) for p in local_parts()]],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
        )
        unz = subprocess.Popen(
            ["zstd", "-d", "-c"], stdin=cat.stdout,
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
        )
        cat.stdout.close()
        lst = subprocess.Popen(
            ["tar", "-tf", "-"], stdin=unz.stdout,
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
        )
        unz.stdout.close()
        for _ in lst.stdout:
            entries += 1
            if entries % 5000 == 0:
                progress.update(task, size=f"{entries:,} entries")
        vrcs = (cat.wait(), unz.wait(), lst.wait())

    if any(vrcs) or entries == 0:
        console.print(f"[red]verification FAILED[/red] (exit {vrcs}, {entries} entries)")
        console.print("  No completion marker written. Do not upload these parts.")
        journal.write(event="verify_failed", codes=vrcs, entries=entries)
        journal.close()
        return 1

    COMPLETE_MARKER.write_text(f"{entries}\n")
    console.print(f"[green][OK][/green] verified: {entries:,} entries")
    console.print(
        f"  {len(local_parts())} parts, "
        f"{human(sum(p.stat().st_size for p in local_parts()))}"
    )
    journal.write(event="stage_done", entries=entries, parts=len(local_parts()))
    journal.close()
    return 0


# --- verify -------------------------------------------------------------------


def classify_missing(path: Path) -> str:
    if path.is_symlink() and not path.exists():
        return "broken symlink"
    if path.is_file() and path.stat().st_size == 0:
        return "zero bytes"
    if path.exists() and not os.access(path, os.R_OK):
        return "unreadable"
    return "unknown"


def cmd_verify(args) -> int:
    dirs = args.dirs or PLAIN_DIRS
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    total_missing = 0

    parts = local_parts()
    if parts:
        n = remote_part_count()
        tag = "[green][OK][/green]" if n >= len(parts) else "[red][ERROR][/red]"
        console.print(f"{tag} archive: {n} of {len(parts)} parts on the remote")
        if not COMPLETE_MARKER.exists():
            console.print(
                "[yellow][WARN][/yellow] no .archive-complete marker — the "
                "staged parts were never verified"
            )

    for d in dirs:
        local = HOME / d
        if not local.is_dir():
            continue

        local_files = set()
        for root, _dirs, names in os.walk(local, onerror=lambda e: None):
            rel = Path(root).relative_to(local)
            for n in names:
                local_files.add(str(rel / n) if str(rel) != "." else n)

        with Progress(
            SpinnerColumn(), TextColumn("{task.description}"),
            TextColumn("[cyan]{task.completed} files"), console=console,
        ) as progress:
            task = progress.add_task(f"listing remote {d}", total=None)
            walk = remote_walk(f"{REMOTE}/{d}", progress, task)

        # An incomplete listing cannot distinguish "absent" from "not looked
        # at", and reporting the difference anyway would send you re-uploading
        # data that is already there.
        if not walk.complete:
            console.print(
                f"[red][ERROR][/red] {d}: {len(walk.unreadable)} folder "
                f"listing(s) failed after retries — the remote picture is "
                f"incomplete, so nothing is reported missing for this "
                f"directory."
            )
            for p in walk.unreadable[:5]:
                console.print(f"    [dim]{p}[/dim]")
            if len(walk.unreadable) > 5:
                console.print(f"    [dim]... and {len(walk.unreadable) - 5} more[/dim]")
            console.print(
                f"    [dim]retry, or lower LIST_WORKERS (currently "
                f"{LIST_WORKERS}) if this persists[/dim]"
            )
            total_missing += 1
            continue

        missing = sorted(local_files - walk.files)
        if not missing:
            console.print(
                f"[green][OK][/green] {d}: all {len(local_files)} files present"
            )
            continue

        total_missing += len(missing)
        console.print(
            f"[yellow][WARN][/yellow] {d}: {len(missing)} of "
            f"{len(local_files)} files NOT on the remote"
        )
        with FAILURES.open("a", encoding="utf-8") as fh:
            for rel in missing:
                why = classify_missing(local / rel)
                fh.write(
                    f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')}\t{d}\t{d}/{rel}\t{why}\n"
                )
        for rel in missing[:10]:
            console.print(f"    {classify_missing(local / rel):<15} {rel}")
        if len(missing) > 10:
            console.print(f"    ... and {len(missing) - 10} more (see {FAILURES})")

    return 1 if total_missing else 0


# --- status / logs / eta ------------------------------------------------------


def cmd_status(_args) -> int:
    t = Table(title="home-backup status", show_header=True, header_style="bold")
    t.add_column("item")
    t.add_column("local", justify="right")
    t.add_column("remote", justify="right")

    parts = local_parts()
    t.add_row(
        "archive parts",
        f"{len(parts)} ({human(sum(p.stat().st_size for p in parts))})",
        str(remote_part_count()),
    )
    t.add_row(
        "archive verified",
        "yes" if COMPLETE_MARKER.exists() else "[red]NO[/red]",
        "-",
    )

    remote_names = {
        e["name"]["value"] for e in remote_list_rows(REMOTE, "file")
        if (e.get("name") or {}).get("ok")
    }
    t.add_row("files at remote root", "-", str(len(remote_names)))

    for d in PLAIN_DIRS:
        p = HOME / d
        if not p.is_dir():
            continue
        n = sum(len(f) for _r, _d, f in os.walk(p, onerror=lambda e: None))
        t.add_row(d, f"{n} files ({human(dir_bytes(p))})", "run verify")

    console.print(t)
    console.print(f"\n[dim]remote: {REMOTE}[/dim]")
    console.print(f"[dim]staging: {STAGING}[/dim]")
    return 0


def cmd_logs(args) -> int:
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    journals = sorted(LOG_DIR.glob("*.jsonl"))
    if not journals:
        console.print("[dim]no runs recorded yet[/dim]")
    else:
        t = Table(title="recent runs", header_style="bold")
        for col in ("when", "event", "label", "up", "skip", "fail", "secs"):
            t.add_column(col)
        for j in journals[-args.limit:]:
            for line in j.read_text(encoding="utf-8").splitlines():
                try:
                    r = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if r.get("event") not in ("end", "stage_done", "interrupted"):
                    continue
                t.add_row(
                    r.get("ts", "")[:19], r.get("event", ""), r.get("label", "-"),
                    str(r.get("uploaded", "-")), str(r.get("skipped", "-")),
                    str(r.get("failed", "-")), str(r.get("seconds", "-")),
                )
        console.print(t)

    if FAILURES.exists() and FAILURES.stat().st_size:
        lines = FAILURES.read_text(encoding="utf-8").splitlines()
        console.print(f"\n[bold]files that never reached the remote[/bold] "
                      f"({len(lines)} recorded)")
        for line in lines[-args.limit:]:
            cols = line.split("\t")
            if len(cols) >= 4:
                console.print(f"  [yellow]{cols[3]:<15}[/yellow] {cols[2]}")
    return 0


def cmd_eta(_args) -> int:
    plan = planned_bytes()
    done = remote_bytes()
    left = max(0, plan - done)

    rate = Rate()
    with Progress(
        SpinnerColumn(), TextColumn("sampling throughput for 10s"), console=console
    ) as p:
        p.add_task("", total=None)
        for _ in range(10):
            rate.sample()
            time.sleep(1)

    bps = rate.bytes_per_sec()
    eta = (left / bps) if bps and bps > 0 else None

    t = Table(show_header=False)
    t.add_row("planned", human(plan))
    t.add_row("on remote", human(done))
    t.add_row("remaining", human(left))
    t.add_row("rate", human_rate(bps))
    t.add_row("ETA", fmt_dur(eta))
    console.print(t)
    console.print(
        "[dim]remote figure counts the archive parts at the root only; "
        "per-directory totals need verify.[/dim]"
    )
    return 0


# --- entry point --------------------------------------------------------------


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="home-backup", description="Back up $HOME to Proton Drive."
    )
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("stage", help="build archives into ~/backup-staging")
    p.add_argument("--force", action="store_true",
                   help="discard partial parts and start over")
    p.set_defaults(fn=cmd_stage)

    p = sub.add_parser("upload", help="push staging + plain dirs to Proton Drive")
    p.add_argument("dirs", nargs="*", help=f"subset of: {' '.join(PLAIN_DIRS)}")
    p.set_defaults(fn=cmd_upload)

    p = sub.add_parser("verify", help="name every local file missing remotely")
    p.add_argument("dirs", nargs="*", help=f"subset of: {' '.join(PLAIN_DIRS)}")
    p.set_defaults(fn=cmd_verify)

    p = sub.add_parser("status", help="what exists locally and remotely")
    p.set_defaults(fn=cmd_status)

    p = sub.add_parser("logs", help="past runs and unreached files")
    p.add_argument("-n", "--limit", type=int, default=20)
    p.set_defaults(fn=cmd_logs)

    p = sub.add_parser("eta", help="throughput and finish time")
    p.set_defaults(fn=cmd_eta)

    args = parser.parse_args()

    if not shutil.which("zstd") and args.cmd == "stage":
        console.print("[red]zstd not found[/red]")
        return 1

    signal.signal(signal.SIGINT, lambda *_: (_ for _ in ()).throw(KeyboardInterrupt))
    try:
        return args.fn(args)
    except KeyboardInterrupt:
        console.print("\n[yellow]Interrupted.[/yellow] Nothing was modified.")
        return 130


if __name__ == "__main__":
    sys.exit(main())
