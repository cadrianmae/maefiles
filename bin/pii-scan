#!/usr/bin/env python3
# pii-scan: skip
"""
pii-scan — grep for personally identifiable information in files or dirs.

Single-pass per file using compiled regex alternation. Replaces a bash
implementation that shelled out per-pattern-per-line (O(N*M) subprocess calls).

Usage:
    pii-scan <path> [<path> ...]
    pii-scan --all               # scan every yadm-tracked file
    pii-scan --staged            # scan yadm-staged changes only (pre-commit)

Extra user patterns: put ERE regex (one per line, # for comments) in
    ~/docs/secret/pii-patterns.txt  (git-crypted).

Pragma to skip a whole file: include `pii-scan: skip` anywhere in its
first 100 lines (e.g. in a comment).

Exit code:
    0  no matches
    1  matches found (redacted, grouped by file)
    2  usage error
"""

from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
from pathlib import Path
from typing import Iterable

HOME = Path.home()

# ---------------------------------------------------------------------------
# Safe-pattern filter: matches that LOOK like PII but are known benign.
# Values matching any of these are dropped from findings.
# ---------------------------------------------------------------------------
SAFE = [
    # Git-hosting SSH URLs
    r"^git@github\.com$",
    r"^git@gitlab\.com$",
    r"^git@bitbucket\.org$",
    r"^[A-Za-z0-9._+-]+@users\.noreply\.github\.com$",
    r"^noreply@[A-Za-z0-9.-]+$",
    # Example / placeholder emails
    r"^example@[A-Za-z0-9.-]+$",
    r"^.*@example\.(com|org|net|ta)$",
    r"^vader@[A-Za-z0-9.-]+$",
    r"^user@[A-Za-z0-9.-]+$",
    r"^foo@[A-Za-z0-9.-]+$",
    r"^bar@[A-Za-z0-9.-]+$",
    # Systemd unit names resembling user@scope.service
    r"^[A-Za-z][A-Za-z0-9._-]*@[A-Za-z0-9._-]+\.(service|target|timer|socket|mount|slice|scope|path|device)$",
    # Fake TLDs (RFC 2606 / 6761)
    r"^.*@[A-Za-z0-9.-]+\.(local|test|invalid|localhost)$",
]
SAFE_RES = [re.compile(p) for p in SAFE]

# ---------------------------------------------------------------------------
# Detection patterns — name → regex
# ---------------------------------------------------------------------------
PATTERNS = [
    ("TU-Dublin-student", r"[Cc][0-9]{8}"),
    ("email",             r"[A-Za-z0-9_][A-Za-z0-9._+%-]*@[A-Za-z0-9][A-Za-z0-9.-]*\.[A-Za-z]{2,}"),
    ("IE-phone",          r"\+353[ -][0-9]{1,2}[ -][0-9]{3,4}[ -]?[0-9]{3,4}"),
    ("IE-mobile",         r"08[3-9][ -]?[0-9]{3}[ -]?[0-9]{4}"),
    ("UK-phone",          r"\+44[ -][0-9]{4,5}[ -][0-9]{5,6}"),
    ("IE-eircode",        r"[ADEHK-NP-TVWXY][0-9]{2} [A-HK-NP-Z0-9]{4}"),
    ("UK-postcode",       r"[A-Z]{1,2}[0-9][A-Z0-9]? [0-9][A-Z]{2}"),
    ("IBAN",              r"(IE|GB|DE|FR|ES|IT|NL|BE|AT|LU|PT|CH)[0-9]{2}[A-Z0-9]{10,30}"),
    ("credit-card",       r"4[0-9]{15}|5[1-5][0-9]{14}|3[47][0-9]{13}"),
    ("legal-name",        r"Mae|,? Mae"),
    ("health-keyword",    r"\b(?:ADHD|autism|autistic|Asperger|medication|prescri\w+|diagnosis|therapist)\b"),
    ("IE-PPS",            r"\b[0-9]{7}[A-Z]{1,2}\b"),
]

# Compile a single alternation with named groups for per-match categorisation
_named_parts = [f"(?P<p{i}>{rx})" for i, (_, rx) in enumerate(PATTERNS)]
_extra_pattern_path = HOME / "docs" / "secret" / "pii-patterns.txt"


def load_extra_patterns() -> list[tuple[str, re.Pattern]]:
    if not _extra_pattern_path.is_file():
        return []
    out = []
    for line in _extra_pattern_path.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        try:
            out.append(("custom", re.compile(line)))
        except re.error as e:
            print(f"[WARN] bad extra pattern: {line} ({e})", file=sys.stderr)
    return out


def is_safe(match: str) -> bool:
    return any(sp.match(match) for sp in SAFE_RES)


def redact(s: str) -> str:
    n = len(s)
    if n <= 4:
        return "****"
    return f"{s[:2]}{'*' * (n - 4)}{s[-2:]}"


def scan_text(text: str, compiled: re.Pattern) -> list[tuple[int, str, str]]:
    """Yield (line_no, category, match) for each non-safe finding."""
    found = []
    for line_no, line in enumerate(text.splitlines(), 1):
        for m in compiled.finditer(line):
            value = m.group()
            if is_safe(value):
                continue
            # Determine category from the first non-None named group
            for idx, (name, _) in enumerate(PATTERNS):
                if m.group(f"p{idx}") is not None:
                    found.append((line_no, name, value))
                    break
    return found


def is_binary(path: Path) -> bool:
    try:
        chunk = path.open("rb").read(4096)
    except OSError:
        return True
    return b"\0" in chunk


def has_skip_pragma(path: Path) -> bool:
    try:
        with path.open("r", errors="replace") as f:
            for _ in range(100):
                line = f.readline()
                if not line:
                    break
                if "pii-scan: skip" in line:
                    return True
    except OSError:
        pass
    return False


def iter_files(paths: Iterable[str]) -> Iterable[Path]:
    skip_dirs = {".git", "node_modules", ".cache", "__pycache__", ".venv", "venv"}
    skip_exts = {".bin", ".jpg", ".jpeg", ".png", ".gif", ".wav", ".mp3", ".mp4",
                 ".webm", ".ogg", ".flac", ".zip", ".gz", ".xz", ".tar", ".7z",
                 ".pdf", ".odp", ".ods", ".odt", ".docx", ".xlsx", ".pptx",
                 ".so", ".o", ".a", ".dylib", ".exe"}
    for p in paths:
        path = Path(p).expanduser()
        if path.is_file():
            yield path
        elif path.is_dir():
            for root, dirs, files in os.walk(path):
                dirs[:] = [d for d in dirs if d not in skip_dirs]
                for name in files:
                    fp = Path(root) / name
                    if fp.suffix.lower() in skip_exts:
                        continue
                    yield fp


def list_tracked() -> list[Path]:
    try:
        out = subprocess.run(["yadm", "ls-files"], capture_output=True, text=True, check=True)
        return [HOME / line for line in out.stdout.splitlines() if line]
    except (FileNotFoundError, subprocess.CalledProcessError):
        return []


def list_staged() -> list[Path]:
    try:
        out = subprocess.run(["yadm", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
                             capture_output=True, text=True, check=True)
        return [HOME / line for line in out.stdout.splitlines() if line]
    except (FileNotFoundError, subprocess.CalledProcessError):
        return []


def main() -> int:
    ap = argparse.ArgumentParser(prog="pii-scan", description=__doc__.splitlines()[1],
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    g = ap.add_mutually_exclusive_group()
    g.add_argument("--all", action="store_true", help="scan every yadm-tracked file")
    g.add_argument("--staged", action="store_true", help="scan yadm-staged changes only")
    ap.add_argument("paths", nargs="*", help="files or directories to scan")
    args = ap.parse_args()

    if args.all:
        files = list_tracked()
    elif args.staged:
        files = list_staged()
    else:
        if not args.paths:
            ap.error("no paths given (use --all or --staged for bulk scans)")
        files = list(iter_files(args.paths))

    if not files:
        print("[OK] nothing to scan")
        return 0

    # Combine all patterns into one compiled regex for single-pass scanning
    combined = re.compile("|".join(_named_parts))
    extra = load_extra_patterns()  # list of (name, compiled)

    findings: dict[Path, list[tuple[int, str, str]]] = {}
    scanned = 0
    for fp in files:
        if not fp.is_file():
            continue
        if is_binary(fp):
            continue
        if has_skip_pragma(fp):
            continue
        try:
            text = fp.read_text(errors="replace")
        except OSError:
            continue
        scanned += 1

        hits = scan_text(text, combined)
        # Also run extra user patterns
        for line_no, line in enumerate(text.splitlines(), 1):
            for name, rx in extra:
                for m in rx.finditer(line):
                    value = m.group()
                    if is_safe(value):
                        continue
                    hits.append((line_no, name, value))

        if hits:
            findings[fp] = hits

    if not findings:
        print(f"[OK] no PII patterns found across {scanned} files")
        return 0

    print("[PII] matches found (values redacted):")
    for fp in sorted(findings):
        rel = fp.relative_to(HOME) if fp.is_relative_to(HOME) else fp
        for line_no, name, value in sorted(findings[fp]):
            print(f"  {rel}:{line_no}  [{name}]  {redact(value)}")
    return 1


if __name__ == "__main__":
    sys.exit(main())
