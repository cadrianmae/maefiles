#!/usr/bin/env bash
# render-env — generate .env##template.esh from docs/secret/manifest.yaml
#
# Output: $HOME/.env##template.esh (local only, gitignored)
# The template is consumed by `yadm alt` which runs it through esh and
# writes the result to $HOME/.env
#
# Usage:
#   render-env                  # normal
#   render-env --check          # exit 1 if template would differ from existing
#   render-env --stdout         # print to stdout instead of writing

set -euo pipefail

MANIFEST="$HOME/docs/secret/manifest.yaml"
OUT="$HOME/.env##template.esh"
MODE="write"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --check)  MODE="check" ;;
    --stdout) MODE="stdout" ;;
    *) echo "[ERROR] unknown flag: $1" >&2; exit 1 ;;
  esac
  shift
done

[[ -f "$MANIFEST" ]] || { echo "[ERROR] manifest missing: $MANIFEST" >&2; exit 1; }
command -v yq >/dev/null || { echo "[ERROR] yq required" >&2; exit 1; }

render() {
  cat <<'HEADER'
# Auto-generated by bin/render-env from docs/secret/manifest.yaml
# DO NOT edit by hand — edit the manifest instead, then re-run render-env.
# This file is also gitignored; your rendered ~/.env is what your shell reads.

HEADER

  yq -r '.secrets[] | "export \(.env)=<%= pass show \(.pass) %>"' "$MANIFEST"

  cat <<'FOOTER'

# Per-class overrides go below this line (hand-written, outside the auto-gen block).
FOOTER
}

case "$MODE" in
  stdout)
    render
    ;;
  check)
    if ! diff -q <(render) "$OUT" >/dev/null 2>&1; then
      echo "[FAIL] $OUT out of date with manifest.yaml" >&2
      diff <(render) "$OUT" >&2 || true
      exit 1
    fi
    echo "[OK] $OUT matches manifest"
    ;;
  write)
    render > "$OUT"
    echo "[OK] wrote $OUT"
    ;;
esac
