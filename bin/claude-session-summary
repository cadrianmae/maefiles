#!/bin/bash
# claude-session-summary - Generate AI summary of current Claude Code session
# Usage: claude-session-summary [session-id]
#
# If no session-id provided, uses latest session from current directory's project

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to encode directory path to project name
encode_project_path() {
    local path="$1"
    # Convert /home/user/path to -home-user-path
    # Remove leading slash first, then replace remaining slashes with dashes, then add leading dash
    path="${path#/}"  # Remove leading /
    echo "-${path//\//-}"
}

# Function to get latest session ID for current directory
get_current_session_id() {
    local cwd="$PWD"
    local project_dir="/home/cadrianmae/.claude/projects/$(encode_project_path "$cwd")"

    if [[ ! -d "$project_dir" ]]; then
        echo -e "${RED}Error: No project directory found for $cwd${NC}" >&2
        echo -e "${YELLOW}Expected: $project_dir${NC}" >&2
        return 1
    fi

    # Find the most recently modified .jsonl file (exclude agent-* files)
    local latest_session
    latest_session=$(/usr/bin/find "$project_dir" -maxdepth 1 -name "*.jsonl" ! -name "agent-*.jsonl" -type f -exec stat -c '%Y %n' {} \; 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)

    if [[ -z "$latest_session" ]]; then
        echo -e "${RED}Error: No session transcripts found in $project_dir${NC}" >&2
        return 1
    fi

    # Extract session ID from filename
    basename "$latest_session" .jsonl
}

# Function to find transcript file
find_transcript() {
    local session_id="$1"

    # Search all project directories for this session
    /usr/bin/find /home/cadrianmae/.claude/projects/ -name "${session_id}.jsonl" 2>/dev/null | head -1
}

# Function to count messages in transcript
count_messages() {
    local transcript="$1"

    # Count user and assistant messages only
    jq -r '
        select(.type == "user" or .type == "assistant")
    ' "$transcript" 2>/dev/null | wc -l
}

# Function to generate summary using claude CLI
generate_summary() {
    local session_id="$1"

    local prompt="Give me a one-line summary of this conversation. Maximum 60 characters (approximately 10-12 words). Be concise and specific about what was discussed or accomplished."

    # Use claude CLI to resume session and generate summary
    # --model haiku for speed and low cost
    # --print for non-interactive output
    local claude_bin="$HOME/.claude/local/claude"
    local timeout_seconds="${CLAUDE_TIMEOUT:-60}"

    if [[ ! -x "$claude_bin" ]]; then
        echo -e "${RED}Error: claude binary not found at $claude_bin${NC}" >&2
        return 1
    fi

    local result
    # Use timeout command to prevent hanging
    result=$(timeout "$timeout_seconds" "$claude_bin" -r "$session_id" --print --model haiku --tools "" "$prompt" 2>&1)
    local exit_code=$?

    if [[ $exit_code -eq 124 ]]; then
        echo -e "${RED}Error: claude command timed out after ${timeout_seconds}s${NC}" >&2
        return 1
    elif [[ $exit_code -ne 0 ]]; then
        echo -e "${RED}Error: claude command failed with exit code $exit_code${NC}" >&2
        echo "Output: $result" >&2
        return 1
    fi

    echo "$result"
}

# Main script
main() {
    local session_id="${1:-}"

    # Get session ID if not provided
    if [[ -z "$session_id" ]]; then
        echo -e "${YELLOW}No session ID provided, using latest session from current directory...${NC}"
        session_id=$(get_current_session_id) || exit 1
    fi

    echo -e "${GREEN}Session ID:${NC} $session_id"

    # Find transcript file
    echo -e "${YELLOW}Finding transcript...${NC}"
    local transcript
    transcript=$(find_transcript "$session_id")

    if [[ -z "$transcript" ]]; then
        echo -e "${RED}Error: No transcript found for session $session_id${NC}" >&2
        exit 1
    fi

    echo -e "${GREEN}Transcript:${NC} $transcript"

    # Count messages
    local msg_count
    msg_count=$(count_messages "$transcript")
    echo -e "${GREEN}Messages:${NC} $msg_count"

    # Generate summary
    echo -e "${YELLOW}Generating summary...${NC}"
    local summary
    summary=$(generate_summary "$session_id")

    if [[ -z "$summary" ]]; then
        echo -e "${RED}Error: Failed to generate summary${NC}" >&2
        exit 1
    fi

    # Trim to 80 chars if needed
    summary=$(echo "$summary" | tr -d '\n' | cut -c1-80)

    echo ""
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${GREEN}Summary:${NC} $summary"
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

    # Output as JSON for scripting
    if [[ "${OUTPUT_JSON:-}" == "1" ]]; then
        jq -n \
            --arg session_id "$session_id" \
            --arg transcript "$transcript" \
            --arg summary "$summary" \
            --argjson msg_count "$msg_count" \
            '{session_id: $session_id, transcript: $transcript, summary: $summary, message_count: $msg_count}'
    fi
}

# Show help
if [[ "${1:-}" == "-h" ]] || [[ "${1:-}" == "--help" ]]; then
    cat << 'HELP'
claude-session-summary - Generate AI summary of Claude Code session

USAGE:
    claude-session-summary [SESSION_ID]

ARGUMENTS:
    SESSION_ID    Optional. Session UUID to summarize.
                  If not provided, uses latest session from current directory.

ENVIRONMENT:
    OUTPUT_JSON      Set to "1" to output JSON instead of formatted text.
    CLAUDE_TIMEOUT   Timeout in seconds for claude command (default: 60)

EXAMPLES:
    # Summarize latest session in current directory
    claude-session-summary

    # Summarize specific session
    claude-session-summary 656914fa-7562-4f6e-b68a-af74645c68c1

    # Get JSON output for scripting
    OUTPUT_JSON=1 claude-session-summary

OUTPUT:
    Prints session ID, transcript path, message count, and AI-generated summary.
    Summary is limited to 80 characters (~10-12 words).

NOTES:
    - Uses 'claude -r {session_id} --print' to resume session
    - Uses Haiku model for fast, cheap summaries
    - Disables tools (--tools "") for text-only response
    - Finds latest session by modification time in project directory
    - Excludes agent-* subtask sessions

HELP
    exit 0
fi

main "$@"
