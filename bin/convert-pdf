#!/usr/bin/env python3

"""
PDF to Document Converter
Converts PDF files to various document formats using Mistral AI's OCR capabilities.
Default output format is Markdown.

Author: Generated by GitHub Copilot
Date: 2025-10-07
"""

import argparse
import base64
import os
import sys
import time
from pathlib import Path
from typing import Optional, List, Dict

try:
    from mistralai import Mistral
except ImportError:
    print("Error: mistralai library not found. Install it with: pip install mistralai")
    sys.exit(1)


class PDFConverter:
    """PDF to document converter using Mistral AI OCR."""
    
    def __init__(self, api_key: Optional[str] = None):
        """Initialize the converter with Mistral API key."""
        self.api_key = api_key or os.environ.get("MISTRAL_API_KEY")
        if not self.api_key:
            raise ValueError("MISTRAL_API_KEY environment variable is required or pass --api-key")
        
        self.client = Mistral(api_key=self.api_key)
    
    def _retry_mistral_request(self, request_func, *args, **kwargs):
        """Retry Mistral API requests with exponential backoff."""
        max_retries = 2
        base_delay = 1.0
        
        for attempt in range(max_retries + 1):
            try:
                return request_func(*args, **kwargs)
            except Exception as e:
                if attempt == max_retries:
                    # Last attempt failed, re-raise the exception
                    raise e
                
                # Check if it's a retryable error
                error_str = str(e).lower()
                if any(keyword in error_str for keyword in ['rate', '429', 'timeout', 'connection', 'service']):
                    delay = base_delay * (2 ** attempt)
                    print(f"Request failed (attempt {attempt + 1}/{max_retries + 1}): {e}")
                    print(f"Retrying in {delay} seconds...")
                    time.sleep(delay)
                else:
                    # Non-retryable error, fail immediately
                    raise e
        
    def encode_pdf(self, pdf_path: str) -> Optional[str]:
        """Encode the PDF to base64."""
        try:
            with open(pdf_path, "rb") as pdf_file:
                return base64.b64encode(pdf_file.read()).decode('utf-8')
        except FileNotFoundError:
            print(f"Error: The file {pdf_path} was not found.")
            return None
        except Exception as e:
            print(f"Error reading PDF file: {e}")
            return None
    
    def process_pdf_with_mistral(self, pdf_path: str, save_images: bool = True) -> Optional[tuple]:
        """Process PDF using Mistral OCR and return extracted text and images."""
        print(f"Processing PDF: {pdf_path}")
        
        # Encode PDF to base64
        base64_pdf = self.encode_pdf(pdf_path)
        if not base64_pdf:
            return None
            
        try:
            print("Sending PDF to Mistral OCR...")
            ocr_response = self._retry_mistral_request(
                self.client.ocr.process,
                model="mistral-ocr-latest",
                document={
                    "type": "document_url",
                    "document_url": f"data:application/pdf;base64,{base64_pdf}" 
                },
                include_image_base64=True
            )
            
            # Extract text and images from the response
            # Response format: {"pages": [{"index": 0, "markdown": "string", "images": [...], ...}, ...]}
            if hasattr(ocr_response, 'pages') and ocr_response.pages:
                combined_text = ""
                all_images = []
                
                for page in ocr_response.pages:
                    page_num = getattr(page, 'index', 0) + 1
                    
                    # Process page text
                    if hasattr(page, 'markdown') and page.markdown:
                        combined_text += f"\n\n## Page {page_num}\n\n{page.markdown}\n\n"
                    
                    # Process page images
                    if hasattr(page, 'images') and page.images and save_images:
                        for image in page.images:
                            if hasattr(image, 'image_base64') and image.image_base64:
                                image_info = {
                                    'page': page_num,
                                    'id': getattr(image, 'id', f"page_{page_num}_image_{len(all_images)}"),
                                    'base64': image.image_base64,
                                    'annotation': getattr(image, 'image_annotation', ''),
                                    'coordinates': {
                                        'top_left_x': getattr(image, 'top_left_x', 0),
                                        'top_left_y': getattr(image, 'top_left_y', 0),
                                        'bottom_right_x': getattr(image, 'bottom_right_x', 0),
                                        'bottom_right_y': getattr(image, 'bottom_right_y', 0)
                                    }
                                }
                                all_images.append(image_info)
                
                return (combined_text.strip(), all_images) if save_images else (combined_text.strip(), [])
            else:
                print("Warning: No pages found in Mistral OCR response")
                print(f"Response type: {type(ocr_response)}")
                if hasattr(ocr_response, '__dict__'):
                    print(f"Response content: {ocr_response.__dict__}")
                return None
                
        except Exception as e:
            print(f"Error processing PDF with Mistral OCR: {e}")
            return None
    
    def save_images(self, images: List[Dict], pdf_path: str) -> Dict[str, str]:
        """Save extracted images to a subdirectory and return mapping of image_id -> local_path."""
        if not images:
            return {}
        
        # Create images subdirectory
        pdf_name = Path(pdf_path).stem
        images_dir = Path(pdf_path).parent / f"{pdf_name}_images"
        images_dir.mkdir(exist_ok=True)
        
        image_paths = {}
        saved_count = 0
        
        print(f"Saving {len(images)} images to: {images_dir}")
        
        for i, image_info in enumerate(images):
            try:
                # Decode base64 image
                image_data = base64.b64decode(image_info['base64'])
                
                # Generate filename
                image_id = image_info['id']
                page_num = image_info['page']
                annotation = image_info.get('annotation', '')
                
                # Try to detect image format from base64 header or use PNG as default
                if image_data.startswith(b'\x89PNG'):
                    ext = 'png'
                elif image_data.startswith(b'\xff\xd8'):
                    ext = 'jpg'
                elif image_data.startswith(b'GIF'):
                    ext = 'gif'
                else:
                    ext = 'png'  # Default to PNG
                
                filename = f"page_{page_num:02d}_image_{i:03d}.{ext}"
                image_path = images_dir / filename
                
                # Save image
                with open(image_path, 'wb') as f:
                    f.write(image_data)
                
                # Store relative path for markdown
                relative_path = f"{pdf_name}_images/{filename}"
                image_paths[image_id] = relative_path
                
                # Also map annotation if it exists (in case it's used as reference)
                if annotation:
                    image_paths[annotation] = relative_path
                
                saved_count += 1
                
                print(f"  └─ {filename} (ID: {image_id})", end="")
                if annotation:
                    print(f": {annotation}")
                else:
                    print()
                    
            except Exception as e:
                print(f"  ✗ Failed to save image {i}: {e}")
        
        print(f"Successfully saved {saved_count}/{len(images)} images")
        print(f"Image ID mappings: {list(image_paths.keys())}")
        return image_paths
    
    def replace_images_in_markdown(self, markdown_text: str, images: List[Dict], image_paths: Dict[str, str] = None) -> str:
        """Replace image references in markdown with local file paths or annotations."""
        if not images:
            return markdown_text
        
        updated_text = markdown_text
        
        # If no image_paths provided (--no-images), replace with annotations
        if not image_paths:
            return self.replace_images_with_annotations(markdown_text, images)
        
        # Create a mapping from image IDs to local paths
        for image_info in images:
            image_id = image_info['id']
            if image_id in image_paths:
                local_path = image_paths[image_id]
                
                # Replace various possible image reference patterns
                # Pattern 1: ![image_id](image_id)
                updated_text = updated_text.replace(f"![{image_id}]({image_id})", f"![{image_id}]({local_path})")
                
                # Pattern 2: ![](image_id)
                updated_text = updated_text.replace(f"![]({image_id})", f"![Image]({local_path})")
                
                # Pattern 3: Just the image_id as a reference
                # Be more careful with this one to avoid replacing text content
                import re
                # Look for markdown image patterns with the image_id
                pattern = re.compile(rf'!\[([^\]]*)\]\({re.escape(image_id)}\)')
                updated_text = pattern.sub(rf'![\1]({local_path})', updated_text)
                
                # Also handle cases where the annotation might be used as alt text
                annotation = image_info.get('annotation', '')
                if annotation:
                    # Replace references using annotation as the identifier
                    updated_text = updated_text.replace(f"![{annotation}]({image_id})", f"![{annotation}]({local_path})")
                    updated_text = updated_text.replace(f"![{annotation}]({annotation})", f"![{annotation}]({local_path})")
        
        return updated_text
    
    def replace_images_with_annotations(self, markdown_text: str, images: List[Dict]) -> str:
        """Replace image references with their annotations when --no-images is used."""
        updated_text = markdown_text
        
        print("DEBUG: Replacing images with annotations...")
        print(f"DEBUG: Found {len(images)} images to process")
        
        for i, image_info in enumerate(images):
            image_id = image_info['id']
            annotation = image_info.get('annotation', '')
            
            print(f"DEBUG: Processing image {i+1}: ID='{image_id}', Annotation='{annotation}'")
            
            # Determine replacement text
            if annotation:
                replacement = f"*[Image: {annotation}]*"
            else:
                replacement = f"*[Image {i+1}]*"
            
            # Replace various possible image reference patterns with annotation text
            import re
            
            # First, let's find all image patterns in the text to see what we're working with
            all_image_patterns = re.findall(r'!\[([^\]]*)\]\(([^)]+)\)', updated_text)
            if i == 0:  # Only print once
                print(f"DEBUG: Found image patterns in markdown: {all_image_patterns}")
            
            replaced = False
            
            # Pattern 1: ![anything](image_id) - most comprehensive
            pattern = re.compile(rf'!\[([^\]]*)\]\({re.escape(image_id)}\)')
            if pattern.search(updated_text):
                updated_text = pattern.sub(replacement, updated_text)
                print(f"DEBUG: Replaced pattern ![...]({image_id}) with annotation")
                replaced = True
            
            # Pattern 2: Direct replacements with image_id
            if f"![{image_id}]({image_id})" in updated_text:
                updated_text = updated_text.replace(f"![{image_id}]({image_id})", replacement)
                print(f"DEBUG: Replaced direct pattern ![{image_id}]({image_id})")
                replaced = True
                
            if f"![]({image_id})" in updated_text:
                updated_text = updated_text.replace(f"![]({image_id})", replacement)
                print(f"DEBUG: Replaced empty pattern ![]({image_id})")
                replaced = True
            
            # Pattern 3: If annotation is used as reference
            if annotation:
                if f"![{annotation}]({annotation})" in updated_text:
                    updated_text = updated_text.replace(f"![{annotation}]({annotation})", replacement)
                    print(f"DEBUG: Replaced annotation pattern ![{annotation}]({annotation})")
                    replaced = True
                    
                if f"![{annotation}]({image_id})" in updated_text:
                    updated_text = updated_text.replace(f"![{annotation}]({image_id})", replacement)
                    print(f"DEBUG: Replaced mixed pattern ![{annotation}]({image_id})")
                    replaced = True
            
            # Pattern 4: Try common variations
            # Sometimes the image might be referenced by filename or other patterns
            possible_refs = [image_id, annotation] if annotation else [image_id]
            for ref in possible_refs:
                if ref:
                    # Look for any image pattern containing this reference
                    pattern = re.compile(rf'!\[([^\]]*)\]\([^)]*{re.escape(ref)}[^)]*\)')
                    matches = pattern.findall(updated_text)
                    if matches:
                        updated_text = pattern.sub(replacement, updated_text)
                        print(f"DEBUG: Replaced pattern containing '{ref}': {matches}")
                        replaced = True
            
            if not replaced:
                print(f"DEBUG: No replacement made for image {i+1} (ID: {image_id})")
        
        # Count remaining image patterns
        remaining_patterns = re.findall(r'!\[([^\]]*)\]\(([^)]+)\)', updated_text)
        print(f"DEBUG: Remaining image patterns after replacement: {remaining_patterns}")
        
        return updated_text
    
    def enhance_with_chat_completion(self, raw_text: str, filename: str, enhance_level: str = "light") -> Optional[str]:
        """Use Mistral chat completions to clean up and enhance the OCR output."""
        if not raw_text:
            return None
            
        # Define enhancement prompts based on level
        enhancement_prompts = {
            "light": """You are a text cleaning tool. Clean up this OCR text output while preserving all original content and meaning. Make these minimal improvements:

1. Fix obvious OCR errors (e.g., "teh" → "the", "wlth" → "with")
2. Normalize spacing and line breaks
3. Improve markdown formatting structure
4. Fix broken headers and lists
5. Ensure proper punctuation

CRITICAL OUTPUT RULES:
- Return ONLY the cleaned text content
- Do NOT include any explanations, introductions, or comments
- Do NOT say "Here is..." or "I've cleaned up..." or similar phrases
- Do NOT add any conversational text before or after the content
- Start your response immediately with the cleaned content
- End your response immediately after the last line of content

IMPORTANT: Do NOT change the actual content, meaning, or add any new information. Only fix formatting and obvious OCR mistakes. Keep all original text intact.""",

            "moderate": """You are a text cleaning tool. Improve this OCR text output while preserving all original content. Make these improvements:

1. Fix OCR errors and typos
2. Improve markdown structure with proper headers, lists, and formatting
3. Normalize spacing and paragraph breaks
4. Fix broken sentences that were split incorrectly
5. Ensure consistent formatting throughout
6. Add appropriate markdown elements (bold, italic) where clearly intended

CRITICAL OUTPUT RULES:
- Return ONLY the improved text content
- Do NOT include any explanations, introductions, or comments
- Do NOT say "Here is..." or "I've cleaned up..." or similar phrases
- Do NOT add any conversational text before or after the content
- Start your response immediately with the improved content
- End your response immediately after the last line of content

IMPORTANT: Do NOT change the meaning, add new content, or remove any information. Only enhance formatting and fix clear errors.""",

            "heavy": """You are a text cleaning tool. Significantly improve this OCR text output while keeping all original information. Make these comprehensive improvements:

1. Fix all OCR errors and improve readability
2. Create a well-structured markdown document with proper hierarchy
3. Organize content into logical sections with clear headers
4. Fix fragmented sentences and improve flow
5. Add appropriate markdown formatting (tables, lists, emphasis)
6. Ensure professional document structure

CRITICAL OUTPUT RULES:
- Return ONLY the enhanced text content
- Do NOT include any explanations, introductions, or comments
- Do NOT say "Here is..." or "I've cleaned up..." or similar phrases
- Do NOT add any conversational text before or after the content
- Start your response immediately with the enhanced content
- End your response immediately after the last line of content

IMPORTANT: Preserve ALL original information and meaning. Do not add new content or interpretations.""",

            "cleanup": """You are a document cleaning specialist. Clean up this OCR text by removing document artifacts and garbage text while preserving all meaningful content. Focus on these cleanup tasks:

REMOVE THESE ARTIFACTS:
1. Page headers and footers (e.g., "Page 1 of 10", "Chapter 3", "Copyright 2023")
2. Page numbers (standalone numbers or "Page X" patterns)
3. Repeated navigation text (e.g., "Table of Contents", "Index", "References")
4. Watermarks and document metadata
5. Broken/garbled character sequences from scanning artifacts
6. Redundant spacing and line breaks between pages
7. OCR artifacts like random characters or symbols
8. Header/footer text that appears on every page

PRESERVE ALL MEANINGFUL CONTENT:
- Main document text and paragraphs
- Actual headings and section titles (not page headers)
- Lists, tables, and structured content
- Code blocks and examples
- Important notes and callouts
- Captions and figure descriptions

CLEANUP RULES:
- Remove obvious page artifacts but keep document structure
- Merge fragmented sentences that were split across pages
- Remove repetitive boilerplate text
- Clean up spacing while maintaining paragraph structure
- If unsure whether something is content or artifact, keep it

CRITICAL OUTPUT RULES:
- Return ONLY the cleaned document content
- Do NOT include any explanations, introductions, or comments
- Do NOT say "Here is..." or "I've cleaned up..." or similar phrases
- Do NOT add any conversational text before or after the content
- Start your response immediately with the cleaned content
- End your response immediately after the last line of content

IMPORTANT: Focus on removing document artifacts, not changing the actual content meaning."""
        }
        
        try:
            print(f"Enhancing OCR output with {enhance_level} processing...")
            print("Streaming enhanced content (live preview):")
            print("=" * 60)
            
            system_prompt = enhancement_prompts.get(enhance_level, enhancement_prompts["light"])
            user_prompt = f"Document title: {filename}\n\nOCR Output to clean up:\n\n{raw_text}"
            
            # Stream the response for live preview
            stream_response = self._retry_mistral_request(
                self.client.chat.stream,
                model="mistral-small-latest",
                messages=[
                    {"role": "system", "content": system_prompt},
                    {"role": "user", "content": user_prompt}
                ],
                temperature=0.1  # Low temperature for consistent, conservative improvements
            )
            
            enhanced_text = ""
            current_line = ""
            lines_shown = 0
            
            for chunk in stream_response:
                if chunk.data.choices and chunk.data.choices[0].delta.content:
                    content = chunk.data.choices[0].delta.content
                    enhanced_text += content
                    current_line += content
                    
                    # Check if we have a complete line (contains newline)
                    if '\n' in current_line:
                        # Split on newlines and process each complete line
                        parts = current_line.split('\n')
                        
                        for i, part in enumerate(parts[:-1]):  # All but the last part are complete lines
                            # Clear previous lines and show current content
                            self._clear_preview_lines(lines_shown)
                            
                            # Show the current state of enhancement
                            preview_lines = enhanced_text[:enhanced_text.rfind(part) + len(part)].split('\n')
                            for line in preview_lines[-10:]:  # Show last 10 lines
                                # Truncate line to 80 columns (minus 2 for "│ " prefix)
                                truncated_line = line[:78] + ("..." if len(line) > 78 else "")
                                print(f"│ {truncated_line}")
                            
                            lines_shown = min(10, len(preview_lines))
                            
                        # Keep the remainder for the next iteration
                        current_line = parts[-1]
            
            # Clear final preview
            # self._clear_preview_lines(lines_shown)
            
            print("=" * 60)
            print("✓ OCR enhancement completed successfully")
            
            if enhanced_text.strip():
                return enhanced_text.strip()
            else:
                print("Warning: No enhanced content received from chat completion")
                return raw_text
                
        except Exception as e:
            print(f"Error enhancing OCR output: {e}")
            print("Falling back to original OCR output")
            return raw_text
    
    def _clear_preview_lines(self, num_lines: int):
        """Clear the specified number of lines from terminal."""
        if num_lines > 0:
            # Move cursor up and clear lines
            for _ in range(num_lines):
                print("\033[A\033[K", end="")  # Move up one line and clear it

    def convert_to_markdown(self, text: str, pdf_path: str, enhance: bool = False, enhance_level: str = "light") -> str:
        """Convert extracted text to Markdown format."""
        if not text:
            return ""
            
        # Get filename for title
        filename = Path(pdf_path).stem
        
        # Enhance with chat completion if requested
        if enhance:
            enhanced_text = self.enhance_with_chat_completion(text, filename, enhance_level)
            if enhanced_text:
                text = enhanced_text
        
        # YAML front matter with metadata
        from datetime import datetime
        
        markdown_content = "---\n"
        markdown_content += f"title: \"{filename}\"\n"
        markdown_content += f"source: \"[[{Path(pdf_path).name}]]\"\n"
        markdown_content += f"source_type: \"PDF\"\n"
        markdown_content += f"processed_date: \"{datetime.now().isoformat()}\"\n"
        markdown_content += f"processor: \"{Path(__file__).name}\"\n"
        markdown_content += f"user: \"{os.getenv('USER', 'Unknown')}\"\n"
        markdown_content += f"ocr_model: \"mistral-ocr-latest\"\n"
        if enhance:
            markdown_content += f"enhanced: true\n"
            markdown_content += f"enhancement_level: \"{enhance_level}\"\n"
            markdown_content += f"enhancement_model: \"mistral-small-latest\"\n"
        markdown_content += "---\n\n"
        
        # Add the document title as H1
        markdown_content += f"# {filename}\n\n"
        
        # Since Mistral OCR already returns markdown, we mostly just need to clean it up
        # and add our document structure
        
        # Remove any leading/trailing whitespace and normalize line breaks
        cleaned_text = text.strip()
        
        # If enhancement was used, the text should already be well-formatted
        if enhance:
            markdown_content += cleaned_text
        else:
            # Apply basic formatting for non-enhanced text
            if '##' in cleaned_text or '#' in cleaned_text:
                # Text already has markdown structure
                markdown_content += cleaned_text
            else:
                # Apply basic markdown structure to plain text
                lines = cleaned_text.split('\n')
                processed_lines = []
                
                for line in lines:
                    line = line.strip()
                    if not line:
                        processed_lines.append("")
                        continue
                        
                    # Simple heuristics for markdown formatting
                    # Detect potential headers (lines that are short and followed by content)
                    if len(line) < 100 and line.isupper():
                        processed_lines.append(f"## {line.title()}")
                    elif len(line) < 80 and not line.endswith('.') and not line.endswith(','):
                        # Potential section header
                        processed_lines.append(f"### {line}")
                    else:
                        processed_lines.append(line)
                
                markdown_content += '\n'.join(processed_lines)
        
        return markdown_content
    
    def save_output(self, content: str, output_path: str, format_type: str = "markdown") -> bool:
        """Save the converted content to a file."""
        try:
            with open(output_path, 'w', encoding='utf-8') as f:
                f.write(content)
            print(f"Successfully saved {format_type} to: {output_path}")
            return True
        except Exception as e:
            print(f"Error saving output file: {e}")
            return False
    
    def convert_pdf(self, pdf_path: str, output_path: Optional[str] = None, 
                   format_type: str = "markdown", enhance: bool = False, 
                   enhance_level: str = "light", save_images: bool = True) -> bool:
        """Main conversion method."""
        # Validate input file
        if not Path(pdf_path).exists():
            print(f"Error: PDF file not found: {pdf_path}")
            return False
        
        # Generate output path if not provided
        if not output_path:
            pdf_path_obj = Path(pdf_path)
            if format_type.lower() == "markdown":
                output_path = pdf_path_obj.with_suffix('.md')
            else:
                output_path = pdf_path_obj.with_suffix('.txt')
        
        # Process PDF with Mistral OCR
        ocr_result = self.process_pdf_with_mistral(pdf_path, save_images)
        if not ocr_result:
            print("Failed to extract content from PDF")
            return False
        
        extracted_text, images = ocr_result
        image_paths = {}
        
        # Debug: Show what we extracted
        print(f"DEBUG: Extracted {len(images)} images from OCR")
        for i, img in enumerate(images):
            print(f"DEBUG: Image {i+1}: ID='{img['id']}', Annotation='{img.get('annotation', 'None')}'")
        
        # Save images if any were found
        if images and save_images:
            image_paths = self.save_images(images, pdf_path)
        elif images:
            print(f"DEBUG: Skipping image saving (--no-images), will use annotations for {len(images)} images")
        
        # Convert to desired format
        if format_type.lower() == "markdown":
            converted_content = self.convert_to_markdown(extracted_text, pdf_path, enhance, enhance_level)
            # Handle image references
            if images:
                if save_images and image_paths:
                    # Replace with local file paths
                    converted_content = self.replace_images_in_markdown(converted_content, images, image_paths)
                else:
                    # Replace with annotations (--no-images case)
                    converted_content = self.replace_images_in_markdown(converted_content, images)
        else:
            # For other formats, enhance if requested then use as text
            if enhance:
                filename = Path(pdf_path).stem
                enhanced_text = self.enhance_with_chat_completion(extracted_text, filename, enhance_level)
                converted_content = enhanced_text if enhanced_text else extracted_text
            else:
                converted_content = extracted_text
        
        # Save output
        return self.save_output(converted_content, output_path, format_type)


def main():
    """Main function to handle command line interface."""
    parser = argparse.ArgumentParser(
        description="Convert PDF files to document formats using Mistral AI OCR",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  %(prog)s document.pdf                         # Convert to document.md
  %(prog)s document.pdf -o output.md            # Specify output file
  %(prog)s document.pdf --format text           # Convert to plain text
  %(prog)s document.pdf --enhance               # Clean up OCR with light enhancement
  %(prog)s document.pdf --enhance --enhance-level moderate  # Moderate enhancement
  %(prog)s document.pdf --enhance --enhance-level cleanup  # Remove headers/footers/artifacts
  %(prog)s document.pdf --no-images            # Convert without extracting images
  %(prog)s *.pdf --enhance                      # Convert multiple PDFs with enhancement
  
Environment Variables:
  MISTRAL_API_KEY    Required Mistral AI API key
        """
    )
    
    parser.add_argument(
        'pdf_files',
        nargs='+',
        help='PDF file(s) to convert'
    )
    
    parser.add_argument(
        '-o', '--output',
        help='Output file path (for single file conversion)'
    )
    
    parser.add_argument(
        '-f', '--format',
        choices=['markdown', 'text'],
        default='markdown',
        help='Output format (default: markdown)'
    )
    
    parser.add_argument(
        '--api-key',
        help='Mistral API key (alternatively set MISTRAL_API_KEY env var)'
    )
    
    parser.add_argument(
        '-v', '--verbose',
        action='store_true',
        help='Verbose output'
    )
    
    parser.add_argument(
        '--enhance',
        action='store_true',
        help='Use Mistral chat completion to enhance and clean up OCR output'
    )
    
    parser.add_argument(
        '--enhance-level',
        choices=['light', 'moderate', 'heavy', 'cleanup'],
        default='light',
        help='Enhancement level: light (minimal fixes), moderate (formatting improvements), heavy (comprehensive cleanup), cleanup (remove page headers/footers/artifacts)'
    )
    
    parser.add_argument(
        '--no-images',
        action='store_true',
        help='Skip extracting and saving images from the PDF'
    )
    
    args = parser.parse_args()
    
    # Validate arguments
    if len(args.pdf_files) > 1 and args.output:
        print("Error: Cannot specify output file when converting multiple PDFs")
        sys.exit(1)
    
    try:
        # Initialize converter
        converter = PDFConverter(api_key=args.api_key)
        
        # Process each PDF file
        success_count = 0
        total_files = len(args.pdf_files)
        
        for pdf_file in args.pdf_files:
            if args.verbose:
                print(f"\nProcessing {pdf_file} ({success_count + 1}/{total_files})...")
            
            # Determine output path
            output_path = args.output if args.output else None
            
            # Convert the PDF
            if converter.convert_pdf(pdf_file, output_path, args.format, args.enhance, args.enhance_level, not args.no_images):
                success_count += 1
            else:
                print(f"Failed to convert: {pdf_file}")
        
        # Summary
        if total_files > 1:
            print(f"\nConversion complete: {success_count}/{total_files} files processed successfully")
        
        sys.exit(0 if success_count == total_files else 1)
        
    except ValueError as e:
        print(f"Configuration error: {e}")
        sys.exit(1)
    except KeyboardInterrupt:
        print("\nConversion interrupted by user")
        sys.exit(1)
    except Exception as e:
        print(f"Unexpected error: {e}")
        sys.exit(1)


if __name__ == "__main__":
    main()