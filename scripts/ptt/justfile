# ptt-daemon — push-to-talk for the Keychron K8 Max.
# Run `just` (no args) for the menu.

set shell := ["bash", "-eu", "-c"]

_prefix := env_var('HOME') + '/.local/libexec'
_cflags := "-O2 -Wall -Wextra -std=c11"

# Default: show available recipes.
default:
    @just --list --unsorted

# Compile the daemon into the source directory.
build:
    cc {{ _cflags }} $(pkg-config --cflags libudev) ptt-daemon.c \
        $(pkg-config --libs libudev) -o ptt-daemon

# Build, install to ~/.local/libexec, and restart the service.
install: build
    install -Dm755 ptt-daemon {{ _prefix }}/ptt-daemon
    systemctl --user restart ptt-daemon.service
    @echo "[OK] installed and restarted"

# Install the udev rule granting evdev read access, then reload udev.
# Needs root and prompts on the terminal. Idempotent: safe to rerun.
#
# Was `sudo -A` with SUDO_ASKPASS=/usr/bin/ksshaskpass. That is KDE tooling and
# went with the move to niri, so the target failed outright. A graphical askpass
# buys nothing here anyway -- this is only ever run from a terminal, which sudo
# can prompt on directly. (openssh-askpass is the GTK equivalent if one is ever
# wanted.)
udev-install:
    #!/usr/bin/env bash
    set -euo pipefail
    sudo install -Dm644 99-keychron-ptt.rules /etc/udev/rules.d/99-keychron-ptt.rules
    sudo udevadm control --reload-rules
    sudo udevadm trigger --subsystem-match=input
    echo "[OK] rule installed; checking access"
    just udev-check

# Can this user read the Keychron nodes (and, correctly, nothing else)?
udev-check:
    #!/usr/bin/env bash
    set -euo pipefail
    found=0
    for dev in /dev/input/event*; do
        name=$(cat "/sys/class/input/$(basename "$dev")/device/name" 2>/dev/null || true)
        case "$name" in
            *Keychron*)
                found=1
                if [[ -r "$dev" ]]; then
                    echo "[OK]   $dev readable  ($name)"
                else
                    echo "[FAIL] $dev NOT readable ($name)"
                fi
                ;;
        esac
    done
    [[ $found -eq 1 ]] || echo "[WARN] no Keychron input nodes present"

# Remove the locally built binary (leaves the installed one alone).
clean:
    rm -f ptt-daemon

# Is the service up, and which keyboard nodes did it find?
status:
    @systemctl --user is-active ptt-daemon.service
    @journalctl --user -u ptt-daemon.service -n 20 --no-pager -o cat

# Follow the log — hold F19 and watch for "PTT down" / "PTT up".
logs:
    journalctl --user -u ptt-daemon.service -f -o cat

# Current mute state of the source the daemon drives.
mic:
    wpctl get-volume @DEFAULT_AUDIO_SOURCE@
