# Vim
alias vi="vim"
alias nv="nvim"
alias nvsl='nvim -c '\''lua require("resession").load("Last Session")'\'''

# Cheat sheet
# cs is now a function in .zsh_functions (with grep search support)
# alias cs="cheat"
alias csp="cheat -p personal"

# systemctl --user restart plasma-plasmashell.service
alias restart-plasma="systemctl --user restart plasma-plasmashell.service"
alias clip=wl-copy

alias open="xdg-open"

