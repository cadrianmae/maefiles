# Browse every per-project Claude MEMORY.md in one bat view.
# Null-delim + xargs for space-safe paths; single bat invocation = one pager.
alias clm='find ~/.claude/projects -maxdepth 3 -name MEMORY.md -print0 | xargs -0 bat'

# gitleaks PII rule pack — see ~/git/github.com/cadrianmae/gitleaks-pii-rules
alias piiscan='gitleaks detect --config ~/.config/gitleaks/pii-rules.toml --no-banner'

# Edit wezterm config
alias wezconfig='$EDITOR ~/.config/wezterm/wezterm.lua'

# Flatpak
alias gearlever='flatpak run it.mijorus.gearlever'

# Claude
alias claude='PATH="$HOME/.claude/bin:$PATH" command claude'

